{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yinjiayi.github.io/openeuler-riscv-packages/schemas/upstream-release-evidence.schema.json",
  "title": "Reviewed official upstream release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "source_snapshot_id", "reviewed_at", "policy", "releases"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "reviewed-upstream-releases"},
    "source_snapshot_id": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_only", "official_https_required", "source_sha256_required", "external_packaging_executed"],
      "properties": {
        "stable_only": {"const": true},
        "official_https_required": {"const": true},
        "source_sha256_required": {"const": true},
        "external_packaging_executed": {"const": false}
      }
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/release"}
    }
  },
  "$defs": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "package_id", "canonical_name", "summary", "license", "version", "upstream", "source", "evidence", "build_requires", "requires"],
      "properties": {
        "component_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._+-][a-z0-9]+)*$"},
        "package_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "canonical_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9+_.-]*$"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 160},
        "license": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "required": ["homepage", "repository_url", "release_api", "release_regex", "source_url_template"],
          "properties": {
            "homepage": {"type": "string", "pattern": "^https://"},
            "repository_url": {"type": "string", "pattern": "^https://"},
            "release_api": {"type": "string", "pattern": "^https://"},
            "release_regex": {"type": ["string", "null"], "maxLength": 1024},
            "source_url_template": {"type": "string", "pattern": "^https://.*\\{version\\}.*$"}
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "filename", "sha256"],
          "properties": {
            "url": {"type": "string", "pattern": "^https://"},
            "filename": {"type": "string", "pattern": "^[^/]+$"},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["release_page", "verified_at", "method", "license_file", "archive_inspection"],
          "properties": {
            "release_page": {"type": "string", "pattern": "^https://"},
            "verified_at": {"type": "string", "format": "date-time"},
            "method": {"const": "downloaded-official-archive-and-calculated-sha256"},
            "license_file": {"type": "string", "minLength": 1},
            "archive_inspection": {
              "type": "object",
              "additionalProperties": false,
              "required": ["checked", "root_directory", "absolute_paths", "parent_traversal", "symlinks"],
              "properties": {
                "checked": {"const": true},
                "root_directory": {"type": "string", "minLength": 1},
                "absolute_paths": {"const": false},
                "parent_traversal": {"const": false},
                "symlinks": {"type": "boolean"},
                "unsafe_links": {"const": false},
                "link_count": {"type": "integer", "minimum": 0}
              }
            }
          }
        },
        "build_requires": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "requires": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}

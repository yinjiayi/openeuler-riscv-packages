{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Persistent hosted-step package build history (not physical acceptance)",
  "type": "object",
  "required": ["schema_version", "kind", "repository", "generated_at", "snapshot", "observations", "attempts", "summary", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "package-build-history"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "snapshot": {
      "type": "object",
      "required": ["cutoff", "started_at", "coverage_complete", "lower_bound", "reasons", "listed_run_count", "expected_attempt_count", "processed_attempt_count", "unresolved_count", "windows", "deleted_history_recoverable"],
      "additionalProperties": false,
      "properties": {
        "cutoff": {"type": "string", "format": "date-time"}, "started_at": {"type": "string", "format": "date-time"},
        "repository_created_at": {"type": ["string", "null"]},
        "coverage_complete": {"type": "boolean"}, "lower_bound": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "object"}},
        "listed_run_count": {"type": "integer", "minimum": 0}, "expected_attempt_count": {"type": "integer", "minimum": 0},
        "processed_attempt_count": {"type": "integer", "minimum": 0}, "unresolved_count": {"type": "integer", "minimum": 0},
        "windows": {"type": "array", "items": {"type": "object"}}, "deleted_history_recoverable": {"const": false}
      }
    },
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "attempts": {"type": "array", "items": {
      "type": "object", "required": ["id", "run_id", "run_attempt", "head_sha", "terminal", "status", "api_raw_sha256"], "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "run_id": {"type": "integer", "minimum": 1}, "run_attempt": {"type": "integer", "minimum": 1},
        "head_sha": {"$ref": "#/$defs/sha"}, "terminal": {"type": "boolean"}, "status": {"enum": ["success", "not-successful", "pending", "unresolved"]},
        "api_raw_sha256": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "reason": {"type": "string"}}
    }},
    "summary": {"type": "object", "required": ["distinct_package_count", "distinct_recipe_count", "success_tuple_count"], "additionalProperties": false,
      "properties": {"distinct_package_count": {"type": "integer", "minimum": 0}, "distinct_recipe_count": {"type": "integer", "minimum": 0}, "success_tuple_count": {"type": "integer", "minimum": 0}}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "job": {"type": "object", "required": ["id", "name", "step_name", "step_number", "completed_at", "runner_labels"], "additionalProperties": false,
      "properties": {"id": {"type": "integer", "minimum": 1}, "name": {"type": "string"}, "step_name": {"type": "string"}, "step_number": {"type": "integer", "minimum": 1}, "completed_at": {"type": "string", "format": "date-time"}, "runner_labels": {"type": "array", "items": {"type": "string"}}}},
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "package_id", "head_sha", "recipe_tree_sha", "recipe_blob_sha", "recipe", "provenance", "run_id", "run_attempt", "event", "head_branch", "created_at", "completed_at", "run_url", "build_status", "smoke_status", "evidence_strength", "jobs"],
      "properties": {
        "id": {"type": "string"}, "package_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100},
        "head_sha": {"$ref": "#/$defs/sha"}, "workflow_head_sha": {"$ref": "#/$defs/sha"}, "recipe_tree_sha": {"$ref": "#/$defs/sha"}, "recipe_blob_sha": {"$ref": "#/$defs/sha"},
        "recipe": {"type": "object", "required": ["version", "release", "ref", "rpm_name", "aliases", "discovery_keys"], "additionalProperties": false,
          "properties": {"version": {"type": "string"}, "release": {"type": "string"}, "ref": {"$ref": "#/$defs/sha"}, "rpm_name": {"type": "string"}, "aliases": {"type": "array", "items": {"type": "string"}}, "discovery_keys": {"type": "array", "items": {"type": "string"}}}},
        "provenance": {"type": "object", "required": ["identity_method", "base_sha", "api_raw_sha256"], "additionalProperties": false,
          "properties": {"identity_method": {"enum": ["exact-local-git-delta", "exact-compare-files", "scope-log+exact-local-git-delta", "scope-log+exact-compare-files", "scope-log+exact-package-tree", "legacy-workflow-contract+exact-package-tree"]}, "workflow_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "base_sha": {"$ref": "#/$defs/sha"}, "api_raw_sha256": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
        "run_id": {"type": "integer", "minimum": 1}, "run_attempt": {"type": "integer", "minimum": 1}, "event": {"type": "string"}, "head_branch": {"type": ["string", "null"]},
        "created_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": "string", "format": "date-time"},
        "run_url": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/actions/runs/[1-9][0-9]*$"},
        "build_status": {"const": "passed"}, "smoke_status": {"const": "passed"}, "evidence_strength": {"const": "hosted-step"},
        "jobs": {"type": "object", "required": ["build", "smoke"], "additionalProperties": false, "properties": {"build": {"$ref": "#/$defs/job"}, "smoke": {"$ref": "#/$defs/job"}}}
      }
    }
  }
}

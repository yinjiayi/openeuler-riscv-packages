{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yinjiayi.github.io/openeuler-riscv-packages/schemas/package.schema.json",
  "title": "Managed openEuler RISC-V package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "rpm",
    "upstream",
    "version",
    "discovery",
    "target",
    "build",
    "files",
    "maintenance",
    "updates"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100},
    "rpm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "license"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9+_.-]*$"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 160},
        "license": {"type": "string", "minLength": 1},
        "epoch": {"type": "integer", "minimum": 0}
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "homepage", "source_repository", "release_channel", "release_api"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "homepage": {"type": "string", "format": "uri"},
        "source_repository": {"type": "string", "format": "uri"},
        "release_channel": {"enum": ["stable", "fixture"]},
        "release_api": {"type": ["string", "null"]},
        "release_regex": {"type": ["string", "null"]}
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "release"],
      "properties": {
        "current": {"type": "string", "minLength": 1},
        "release": {"type": "string", "pattern": "^[0-9]+(?:%\\{\\?dist\\})?$"},
        "latest_detected": {"type": ["string", "null"]}
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "lineage"],
      "properties": {
        "snapshot_id": {"type": "string", "minLength": 1},
        "lineage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "package_name", "evidence_url"],
            "properties": {
              "source": {"enum": ["arch-core", "arch-extra", "aur", "opensuse-tumbleweed", "fedora", "debian", "ubuntu", "golden-fixture"]},
              "package_name": {"type": "string", "minLength": 1},
              "package_base": {"type": ["string", "null"]},
              "source_version": {"type": ["string", "null"]},
              "evidence_url": {"type": "string", "format": "uri"},
              "observed_at": {"type": ["string", "null"], "format": "date-time"}
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "release", "arch", "isa", "riscv_status"],
      "properties": {
        "os": {"const": "openEuler"},
        "release": {"const": "24.03-LTS-SP3"},
        "arch": {"const": "riscv64"},
        "isa": {"const": "RVA23"},
        "riscv_status": {"enum": ["unknown", "qemu-buildable", "native-verified", "patched-for-riscv", "qemu-limitation", "unsupported"]}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "network_during_build", "timeout_minutes"],
      "properties": {
        "profile": {"enum": ["qemu-user", "needs-native-riscv"]},
        "network_during_build": {"const": false},
        "timeout_minutes": {"type": "integer", "minimum": 5, "maximum": 360},
        "native_reason": {"type": ["string", "null"]}
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "sources", "patches", "smoke_test"],
      "properties": {
        "spec": {"type": "string", "pattern": "^[^/]+\\.spec$"},
        "sources": {"const": "sources.yaml"},
        "patches": {"type": "array", "items": {"$ref": "#/$defs/patch"}},
        "smoke_test": {"const": "tests/smoke.sh"}
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["active", "golden", "retired", "update-disabled"]},
        "maintainers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "notes": {"type": ["string", "null"]}
      }
    },
    "updates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "last_checked_at", "last_successful_check_at"],
      "properties": {
        "enabled": {"type": "boolean"},
        "last_checked_at": {"type": ["string", "null"], "format": "date-time"},
        "last_successful_check_at": {"type": ["string", "null"], "format": "date-time"},
        "release_provider": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "purpose", "source", "license", "upstream_status", "remove_when"],
      "properties": {
        "file": {"type": "string", "pattern": "^patches/[0-9]{4}-.+\\.patch$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "purpose": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "upstream_status": {"enum": ["not-submitted", "submitted", "accepted", "released", "downstream-only"]},
        "remove_when": {"type": "string", "minLength": 1}
      }
    }
  }
}

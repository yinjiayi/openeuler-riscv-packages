{
  "repository": "yinjiayi/openeuler-riscv-packages",
  "visibility": "public",
  "default_branch": "main",
  "merge": {
    "allow_auto_merge": false,
    "allow_squash_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": false,
    "delete_branch_on_merge": true
  },
  "pages": {
    "build_type": "workflow"
  },
  "actions": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": true,
    "fork_pull_request_approval_policy": "first_time_contributors_new_to_github",
    "self_hosted_qemu_runner": {
      "enabled": true,
      "trust_boundary": "protected-main-only",
      "labels": [
        "self-hosted",
        "linux",
        "x64",
        "oe-rva23-qemu"
      ]
    }
  },
  "actions_variables": {
    "UPDATE_SHARD_SIZE": "100",
    "UPDATE_MAX_CONCURRENCY": "10",
    "UPDATE_HOST_CONCURRENCY": "4",
    "AUR_STALE_DAYS": "730",
    "ARTIFACT_RETENTION_DAYS": "7",
    "REPAIR_MAX_ATTEMPTS": "3"
  },
  "forbidden_actions_secrets": [
    "OPENAI_API_KEY",
    "CODEX_API_KEY"
  ],
  "allowed_actions_secrets": [
    "RPM_REPO_SSH_PRIVATE_KEY"
  ]
}

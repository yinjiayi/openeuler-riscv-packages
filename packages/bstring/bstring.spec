%description
Native shared-only C99 Better String Library with its default UTF-8 support,
four public root headers, SONAME 1 and pkg-config metadata. The existing opt-in
three Check suites are enabled without filtering: 83 registered cases.
Additive target-only C99/C11 multi-TU installed/relocated shared SDK checks do
not replace those suites. No static, CMake, CLI or native-performance claim.
The published BSD-3-Clause option is selected; original source and comparative
documentation attributions, COPYING and the GPLv2 alternative are preserved.

%prep
%setup -q -n msteinert-bstring-3ad93de
python3 - <<'PY_BSTRING_PREP'
import base64,hashlib,json
from pathlib import Path
payload={'consumer.c': {'sha256': '208368ce735663c198a0568d5422e64ec4a266d7ab3675c5038d73da0b69b18f', 'bytes': 3609, 'base64': ''}, 'unicode.c': {'sha256': 'f1185f7c24a0ac36fe6f09c4b5c1d4e16c31e02b2a9d875c5b82b634e1e37f3c', 'bytes': 1889, 'base64': ''}, 'owned.h': {'sha256': 'e5c8b6c86faec161ad34701cb2bfbb7c1272b61df943ab656665464deaf234d0', 'bytes': 515, 'base64': ''}, 'run-qa.py': {'sha256': 'ce71f3b4b330a678a87b3b4014edf420149522fb8d82bc5f8e932f9838f7e402', 'bytes': 14689, 'base64': ''}, 'expected.stdout': {'sha256': '33a66c8cfcfc3ea16cc1c28292fa87734b1d43690a31d2a1ef42b3a07facdfa2', 'bytes': 136, 'base64': 'QklOQVJZX09XTkVSU0hJUF9PSwpFRElUX1NFQVJDSF9PSwpMSVNUX1JPVU5EVFJJUF9PSwpBVVhJTElBUllfQ09ERUNTX09LClVOSUNPREVfQ09OVkVSU0lPTl9PSwpVTklDT0RFX0lURVJBVE9SX09LCkJTVFJJTkdfT1dORURfU0RLX09LCg=='}, 'contract.json': {'sha256': 'f1a432c511da9835fcd9e414c93d621e01c248079eff3418458653312fadb231', 'bytes': 14980, 'base64': ''}}
apache=''
assert not Path('.packaging-qa').exists() and not Path('.packaging-records').exists()
qa=Path('.packaging-qa');qa.mkdir()
for name,row in payload.items():
    assert Path(name).name==name and name not in ('.','..')
    raw=base64.b64decode(row['base64'],validate=True)
    assert len(raw)==row['bytes'] and hashlib.sha256(raw).hexdigest()==row['sha256']
    (qa/name).write_bytes(raw)
contract=json.loads((qa/'contract.json').read_bytes())
assert len(contract['original_files'])==53 and contract['commit']=='3ad93de7fda8b23901d78fefb2afcbc17ba5312a'
records=Path('.packaging-records');notices=records/'source-notices';notices.mkdir(parents=True)
for rel,row in contract['original_files'].items():
    path=Path(rel);assert not path.is_absolute() and '..' not in path.parts
    raw=path.read_bytes()
    assert path.is_file() and not path.is_symlink() and len(raw)==row['bytes'] and hashlib.sha256(raw).hexdigest()==row['sha256'] and bool(path.stat().st_mode&0o111)==row['executable'],rel
    note=notices/(rel+'.notice');note.parent.mkdir(parents=True,exist_ok=True)
    note.write_text(json.dumps(dict(path=rel,bytes=len(raw),sha256=row['sha256'],encoding='base64',base64=base64.b64encode(raw).decode()),sort_keys=True)+'\n')
(records/'original-source-manifest.json').write_text(json.dumps(contract['original_files'],indent=2,sort_keys=True)+'\n')
legal=base64.b64decode(apache,validate=True)
assert hashlib.sha256(legal).hexdigest()=='c71d239df91726fc519c6eb72d318ec65820627232b2f796219e87dcf35d0ab4'
(records/'Apache-2.0-owned-QA.txt').write_bytes(legal)
PY_BSTRING_PREP

%build
export LC_ALL=C LANG=C
export CC=/usr/bin/gcc
export CFLAGS="%{optflags} -UNDEBUG"
export LDFLAGS="%{?build_ldflags}"
# Only the existing opt-in tests are enabled. Native shared/default UTF-8 and
# all other production options are preserved and checked by introspection.
meson setup build --prefix=%{_prefix} --libdir=%{_lib} --buildtype=plain \
    --wrap-mode=nodownload -Denable-tests=true
ninja -C build -j2 -v

%check
DESTDIR="$PWD/.sdk-stage" meson install -C build --no-rebuild
python3 .packaging-qa/run-qa.py --phase build \
    --prefix "$PWD/.sdk-stage%{_prefix}" --libdir "%{_lib}" \
    --source-root "$PWD" --build-dir "$PWD/build" --work-dir "$PWD/.owned-build-qa"

%install
DESTDIR=%{buildroot} meson install -C build --no-rebuild
install -Dpm 0644 .packaging-qa/consumer.c %{buildroot}%{_datadir}/bstring-tests/consumer.c
install -Dpm 0644 .packaging-qa/unicode.c %{buildroot}%{_datadir}/bstring-tests/unicode.c
install -Dpm 0644 .packaging-qa/owned.h %{buildroot}%{_datadir}/bstring-tests/owned.h
install -Dpm 0644 .packaging-qa/run-qa.py %{buildroot}%{_datadir}/bstring-tests/run-qa.py
install -Dpm 0644 .packaging-qa/expected.stdout %{buildroot}%{_datadir}/bstring-tests/expected.stdout
install -Dpm 0644 .packaging-qa/contract.json %{buildroot}%{_datadir}/bstring-tests/contract.json


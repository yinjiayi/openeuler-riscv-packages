From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: openEuler RISC-V Maintainers <noreply@example.invalid>
Date: Tue, 8 Sep 2026 00:00:00 +0000
Subject: [PATCH] cmake: limit x86 flags to x86 targets

The Linux build adds SSE and x86 multilib compiler and linker options to
every architecture except AArch64. RISC-V therefore receives unsupported
`-msse` and may receive the x86-only `-m64` option because the host word-size
test treats every processor name other than x86_64 as 32-bit.

Recognize the native word size through CMake's compiler probe and add the
x86-specific options only when the target processor is x86. This preserves
the existing x86 behavior without weakening the other warning, hardening, or
linker settings.

Patch-Source: downstream audit of the official 1.14.186 source archive
Patch-License: MIT
Upstream-Status: Not Submitted (automated upstream writes forbidden)
Remove-When: Upstream limits -msse/-m32/-m64 to x86 targets and determines
 non-x86 word size without x86 processor-name assumptions.
---
 CMakeLists.txt         | 14 +++++++++-----
 md_cmake_adapter.cmake |  2 +-
 2 files changed, 10 insertions(+), 6 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -450,2 +450,2 @@ elseif (${PLATFORM} STREQUAL linux) # linux
-    if (NOT CMAKE_SYSTEM_PROCESSOR STREQUAL "aarch64")
+    if (CMAKE_SYSTEM_PROCESSOR MATCHES "^(i.86|x86_64|AMD64)$")
         set (COMMON_COMPILE_OPTIONS ${COMMON_COMPILE_OPTIONS}
@@ -456,2 +456,3 @@ elseif (${PLATFORM} STREQUAL linux) # linux
-    if ("${TARGET_ARCH}" STREQUAL "32")
+    if (CMAKE_SYSTEM_PROCESSOR MATCHES "^(i.86|x86_64|AMD64)$" AND
+        "${TARGET_ARCH}" STREQUAL "32")
         set (COMMON_COMPILE_OPTIONS ${COMMON_COMPILE_OPTIONS}
@@ -460,2 +461,3 @@ elseif (${PLATFORM} STREQUAL linux) # linux
-    elseif("${TARGET_ARCH}" STREQUAL "64" AND ${HOST_ARCH} STREQUAL "32")
+    elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(i.86|x86_64|AMD64)$" AND
+           "${TARGET_ARCH}" STREQUAL "64" AND ${HOST_ARCH} STREQUAL "32")
         set (COMMON_COMPILE_OPTIONS ${COMMON_COMPILE_OPTIONS}
@@ -497,2 +499,3 @@ elseif (${PLATFORM} STREQUAL linux) # linux
-    if ("${TARGET_ARCH}" STREQUAL "32")
+    if (CMAKE_SYSTEM_PROCESSOR MATCHES "^(i.86|x86_64|AMD64)$" AND
+        "${TARGET_ARCH}" STREQUAL "32")
         set (COMMON_LINK_OPTIONS ${COMMON_LINK_OPTIONS}
@@ -501,2 +504,3 @@ elseif (${PLATFORM} STREQUAL linux) # linux
-    elseif("${TARGET_ARCH}" STREQUAL "64" AND ${HOST_ARCH} STREQUAL "32")
+    elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(i.86|x86_64|AMD64)$" AND
+           "${TARGET_ARCH}" STREQUAL "64" AND ${HOST_ARCH} STREQUAL "32")
         set (COMMON_LINK_OPTIONS ${COMMON_LINK_OPTIONS}
diff --git a/md_cmake_adapter.cmake b/md_cmake_adapter.cmake
--- a/md_cmake_adapter.cmake
+++ b/md_cmake_adapter.cmake
@@ -106,2 +106,2 @@ endif()
-if (CMAKE_HOST_SYSTEM_PROCESSOR STREQUAL "x86_64") # 64 bits Linux
+if (CMAKE_SIZEOF_VOID_P EQUAL 8) # 64-bit native target
     set (HOST_ARCH "64")
--

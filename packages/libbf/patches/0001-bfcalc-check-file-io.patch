--- a/bfcalc.c
+++ b/bfcalc.c
@@ -31,0 +32,2 @@
+#include <errno.h>
+#include <limits.h>
@@ -10582,2 +10584,3 @@
-    uint8_t *buf;
-    int buf_len;
+    uint8_t *buf = NULL;
+    long file_len;
+    int saved_errno;
@@ -10586,11 +10589,28 @@
-    if (!f) {
-        perror(filename);
-        exit(1);
-    }
-    fseek(f, 0, SEEK_END);
-    buf_len = ftell(f);
-    fseek(f, 0, SEEK_SET);
-    buf = malloc(buf_len + 1);
-    fread(buf, 1, buf_len, f);
-    buf[buf_len] = '\0';
-    fclose(f);
+    if (!f)
+        goto fail;
+    errno = 0;
+    if (fseek(f, 0, SEEK_END) != 0)
+        goto fail;
+    file_len = ftell(f);
+    if (file_len < 0)
+        goto fail;
+    if (file_len > INT_MAX - 1) {
+        errno = EFBIG;
+        goto fail;
+    }
+    if (fseek(f, 0, SEEK_SET) != 0)
+        goto fail;
+    buf = malloc((size_t)file_len + 1);
+    if (!buf) {
+        errno = ENOMEM;
+        goto fail;
+    }
+    errno = 0;
+    if (fread(buf, 1, (size_t)file_len, f) != (size_t)file_len)
+        goto fail;
+    if (fclose(f) != 0) {
+        f = NULL;
+        goto fail;
+    }
+    f = NULL;
+    buf[(size_t)file_len] = '\0';
@@ -10598 +10618 @@
-        *plen = buf_len;
+        *plen = (int)file_len;
@@ -10599,0 +10620,9 @@
+
+ fail:
+    saved_errno = errno ? errno : EIO;
+    if (f)
+        fclose(f);
+    free(buf);
+    errno = saved_errno;
+    perror(filename);
+    exit(1);

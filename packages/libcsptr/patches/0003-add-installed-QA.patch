No original upstream source or test is replaced.
--- /dev/null
+++ b/downstream/consumer.c
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: MIT
+ * Copyright (c) 2026 yinjiayi
+ * Downstream interface/regression checks, not an upstream test replacement.
+ */
+#include <assert.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <csptr/array.h>
+
+static int calls;
+static int expected[3] = {7, 11, 13};
+static int token = 2026;
+
+static void destroy_element(void *ptr, void *meta)
+{
+    s_meta_array *array_meta = meta;
+    assert(calls >= 0 && calls < 3);
+    assert(*(int *) ptr == expected[calls]);
+    assert(array_meta != NULL);
+    assert(array_meta->nmemb == 3 && array_meta->size == sizeof(int));
+    assert(*(int *) (array_meta + 1) == token);
+    ++calls;
+}
+
+static void inspect(int *a)
+{
+    assert(a != NULL);
+    assert(array_length(a) == 3);
+    assert(array_type_size(a) == sizeof(int));
+    assert(*(int *) array_user_meta(a) == token);
+    for (size_t i = 0; i < 3; ++i)
+        assert(a[i] == expected[i]);
+}
+
+int main(void)
+{
+    int *a = shared_ptr(int[3], {7, 11, 13}, destroy_element,
+                       {&token, sizeof(token)});
+    inspect(a);
+    int *b = sref(a);
+    assert(a == b);
+    sfree(a);
+    assert(calls == 0);
+    inspect(b);
+    sfree(b);
+    assert(calls == 3);
+    calls = 0;
+    a = shared_arr(int, 3, {7, 11, 13}, destroy_element,
+                   {&token, sizeof(token)});
+    inspect(a);
+    b = sref(a);
+    sfree(a);
+    assert(calls == 0);
+    inspect(b);
+    sfree(b);
+    assert(calls == 3);
+    calls = 0;
+    a = unique_ptr(int[3], {7, 11, 13}, destroy_element,
+                   {&token, sizeof(token)});
+    inspect(a);
+    sfree(a);
+    assert(calls == 3);
+    puts("libcsptr downstream array API regression: PASS");
+    return 0;
+}
--- /dev/null
+++ b/downstream/run-tests.sh
@@ -0,0 +1,43 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 yinjiayi
+set -euo pipefail
+root=
+if [[ ${1:-} == --staged && $# == 2 ]]; then
+    root=$2
+elif [[ $# != 0 ]]; then
+    printf '%s\n' 'usage: run-tests.sh [--staged ROOT]' >&2
+    exit 2
+fi
+prefix="$root/usr"
+base="$prefix/share/libcsptr/tests"
+if [[ -z $root ]]; then
+    test "$(rpm -q --qf '%{ARCH}' libcsptr)" = riscv64
+    rpm -V libcsptr libcsptr-tests
+fi
+test -f "$prefix/lib64/libcsptr.a"
+for h in config.h smalloc.h array.h smart_ptr.h common.h; do
+    test -s "$prefix/include/csptr/$h"
+done
+pkg-config --exists check
+(cd "$base/original"; sha256sum -c "$base/SHA256SUMS")
+work=$(mktemp -d)
+trap 'rm -rf -- "$work"' EXIT
+# Compile the complete unchanged original suite against installed public API.
+# Preserve all original GNU C compiler diagnostics and keep assertions enabled.
+gcc -std=gnu99 -Wall -Wextra -Werror -g -Wno-unused-result \
+    -Wno-missing-field-initializers -UNDEBUG \
+    -I"$prefix/include" $(pkg-config --cflags check) \
+    "$base/original/test.c" "$base/original/scalar.c" \
+    "$base/original/array.c" "$base/original/shared.c" \
+    "$base/original/misc.c" "$prefix/lib64/libcsptr.a" \
+    $(pkg-config --libs check) -o "$work/check_unit"
+"$work/check_unit" > "$work/original-check.log" 2>&1
+cat "$work/original-check.log"
+grep -F 'Checks: 12, Failures: 0, Errors: 0' "$work/original-check.log"
+gcc -std=gnu99 -Wall -Wextra -Werror -g -Wno-unused-result \
+    -Wno-missing-field-initializers -UNDEBUG -I"$prefix/include" \
+    "$base/consumer.c" "$prefix/lib64/libcsptr.a" -o "$work/consumer"
+"$work/consumer"
+readelf -h "$work/consumer" | grep -E 'Machine:.*RISC-V'
+printf '%s\n' 'PASS original Check cases=12 failures=0 errors=0 downstream shared-array regression=1 skips=0'

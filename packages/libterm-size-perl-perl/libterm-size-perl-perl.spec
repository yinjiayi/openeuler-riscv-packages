# SPDX-License-Identifier: Apache-2.0
Name:           libterm-size-perl-perl
Version:        0.031
Release:        1%{?dist}
Summary:        Read terminal dimensions from Perl
License:        GPL-1.0-or-later OR Artistic-1.0-Perl
URL:            https://metacpan.org/dist/Term-Size-Perl
Source0:        Term-Size-Perl-%{version}.tar.gz
BuildRequires:  gcc
BuildRequires:  make
BuildRequires:  perl
BuildRequires:  perl-devel
BuildRequires:  perl-generators
BuildRequires:  python3
BuildRequires:  perl(ExtUtils::MakeMaker)
BuildRequires:  perl(ExtUtils::CBuilder)
BuildRequires:  perl(Test::More)
BuildRequires:  perl(Exporter)
BuildRequires:  perl(strict)
Requires:       perl
Requires:       perl(Exporter)

%description
Term::Size::Perl reads character and pixel dimensions from terminal
filehandles. The build probes the target ioctl constant and winsize
layout; the generated Perl module therefore belongs to a target-architecture RPM.

%prep
%autosetup -n Term-Size-Perl-%{version} -p1

%build
%{__perl} Makefile.PL INSTALLDIRS=vendor NO_PACKLIST=1 NO_PERLLOCAL=1
%make_build
# Normalize only the volatile comment; retain the actual generated ABI values.
test "$(grep -c '^# created ' Params.pm)" -eq 1
cmp Params.pm blib/lib/Term/Size/Perl/Params.pm
%{__perl} -pi -e 's/^# created .*$/# generated by the upstream terminal ABI probe/' Params.pm blib/lib/Term/Size/Perl/Params.pm
cmp Params.pm blib/lib/Term/Size/Perl/Params.pm

%install
make pure_install DESTDIR=%{buildroot}
cmp Params.pm %{buildroot}%{perl_vendorlib}/Term/Size/Perl/Params.pm

%check
make test TEST_VERBOSE=1
# Independently run the original terminal-dependent test with all three real PTY handles.
python3 - <<'PY'
import errno, fcntl, os, pty, re, select, struct, subprocess, termios, time

master, slave = pty.openpty()
try:
    fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack('HHHH', 41, 97, 970, 410))
    with subprocess.Popen(['/usr/bin/perl', '-Mblib', 't/01_basic.t'],
                          stdin=slave, stdout=slave, stderr=slave) as test:
        os.close(slave)
        slave = None
        data = bytearray()
        deadline = time.monotonic() + 60
        while time.monotonic() < deadline:
            if not select.select([master], [], [], 0.5)[0]:
                continue
            try:
                chunk = os.read(master, 8192)
            except OSError as error:
                if error.errno == errno.EIO:
                    break
                raise
            if not chunk:
                break
            data.extend(chunk)
            if len(data) > 65536:
                test.kill()
                raise RuntimeError('PTY test output exceeded 64 KiB')
        else:
            test.kill()
            raise TimeoutError('original PTY test')
        assert test.wait(timeout=5) == 0
finally:
    if slave is not None:
        os.close(slave)
    os.close(master)
log = bytes(data).replace(b'\r\n', b'\n')
print(log.decode(), end='')
assert re.search(rb'(?m)^1[.][.]17$', log)
assert len(re.findall(rb'(?m)^ok \d+ ', log)) == 17
assert not re.search(rb'(?mi)^not ok\b|^ok[^\n]*# skip\b', log)
assert b'This terminal is 97x41 characters,' in log and b'and 970x410 pixels.' in log
print('original PTY test: 17 passed, no skips (97x41 chars; 970x410 pixels)')
PY


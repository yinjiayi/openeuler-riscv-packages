--- /dev/null
+++ b/downstream/check-results.py
@@ -0,0 +1,12 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 yinjiayi
+import sys
+import xml.etree.ElementTree as ET
+root = ET.parse(sys.argv[1]).getroot()
+cases = root.findall("./testsuite/testcase")
+assert root.tag == "testsuites" and root.attrib["tests"] == "35"
+assert len(cases) == 35 and len({(x.attrib["classname"], x.attrib["name"]) for x in cases}) == 35
+assert all(int(root.attrib.get(k, "0")) == 0 for k in ("failures", "errors", "disabled", "skipped"))
+assert all(x.attrib.get("status") == "run" and x.attrib.get("result") == "completed" for x in cases)
+assert all(x.find("failure") is None and x.find("skipped") is None for x in cases)
+print("All 35 original Bioparser cases completed without failures or skips")
--- /dev/null
+++ b/downstream/consumer.cpp
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 yinjiayi
+#include <bioparser/fasta_parser.hpp>
+#include <cstdint>
+#include <string>
+#include <stdexcept>
+struct Sequence {
+  std::string name, data;
+  Sequence(const char* n, std::uint32_t nl, const char* d, std::uint32_t dl)
+      : name(n, nl), data(d, dl) {}
+};
+int main(int argc, char** argv) {
+  if (argc != 3) return 1;
+  for (int i = 1; i < argc; ++i) {
+    auto parser = bioparser::Parser<Sequence>::Create<bioparser::FastaParser>(argv[i]);
+    for (int round = 0; round != 2; ++round) {
+      auto records = parser->Parse(static_cast<std::uint64_t>(-1));
+      std::size_t names = 0, bases = 0;
+      for (const auto& r : records) { names += r->name.size(); bases += r->data.size(); }
+      if (records.size() != 14 || names != 65 || bases != 109117) return 2;
+      parser->Reset();
+    }
+  }
+  return 0;
+}
--- /dev/null
+++ b/downstream/run-tests.sh
@@ -0,0 +1,30 @@
+#!/bin/bash
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 yinjiayi
+set -euo pipefail
+root=""
+case "${1:-}" in
+  --staged) test "$#" -eq 2; root="$2"; test -d "$root/usr/include/bioparser" ;;
+  "") test "$#" -eq 0; rpm -V bioparser bioparser-tests ;;
+  *) exit 2 ;;
+esac
+qa="$root/usr/share/bioparser/qa"
+test -f "$qa/SHA256SUMS"
+(cd "$qa" && sha256sum --check --strict SHA256SUMS)
+test "$(find "$qa/tests" -maxdepth 1 -name '*_test.cpp' -type f | wc -l)" -eq 6
+test "$(find "$qa/tests/data" -type f | wc -l)" -eq 10
+test "$(find "$qa/biosoup/include/biosoup" -type f | wc -l)" -eq 5
+unset CPATH CPLUS_INCLUDE_PATH C_INCLUDE_PATH LIBRARY_PATH LD_LIBRARY_PATH CMAKE_PREFIX_PATH CMAKE_MODULE_PATH
+while IFS='=' read -r key _; do
+  case "$key" in GTEST_*) unset "$key" ;; esac
+done < <(env)
+tmp=$(mktemp -d)
+trap 'rm -rf -- "$tmp"' EXIT
+cmake -S "$qa" -B "$tmp/build" \
+  -Dbioparser_DIR="$root/usr/lib64/cmake/bioparser" \
+  -DEXPECTED_INCLUDE="$root/usr/include" \
+  -DCMAKE_BUILD_TYPE=RelWithDebInfo -DCMAKE_CXX_FLAGS="-UNDEBUG"
+cmake --build "$tmp/build" --parallel 2
+"$tmp/build/original_suite" --gtest_filter='*' --gtest_output="xml:$tmp/results.xml"
+python3 "$qa/check-results.py" "$tmp/results.xml"
+"$tmp/build/installed_consumer" "$qa/tests/data/sample.fasta" "$qa/tests/data/sample.fasta.gz"

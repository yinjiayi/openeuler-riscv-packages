+__fprintf_chk(FILE *restrict stream, int flag, const char *restrict format, ...)
+{
+	va_list ap;
+	int ret;
+	va_start(ap, format);
+	ret = test_vfprintf_internal(stream, format, ap, 1, flag);
+	va_end(ap);
+	return ret;
+}
+
+
+int
+__vfprintf_chk(FILE *restrict stream, int flag, const char *restrict format, va_list ap)
+{
+	return test_vfprintf_internal(stream, format, ap, 1, flag);

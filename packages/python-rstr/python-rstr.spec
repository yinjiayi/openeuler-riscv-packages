# SPDX-License-Identifier: Apache-2.0
Name:           python-rstr
Version:        3.2.2
Release:        1%{?dist}
Summary:        Generate random strings and strings matching regular expressions
License:        BSD-3-Clause
URL:            https://github.com/leapfrogonline/rstr
Source0:        rstr-3.2.2.tar.gz
BuildRequires:  python3-devel
BuildRequires:  python3-setuptools >= 61.2
BuildRequires:  python3-setuptools_scm >= 3.4.3
BuildRequires:  python3-wheel
BuildRequires:  python3-pip
BuildRequires:  python3-mypy
Requires:       python3
Requires:       python3-mypy
BuildArch:      noarch

%description
Rstr generates random strings and strings matching regular expressions.
The complete upstream unittest suite and strict typing input are included
for installed-package acceptance.

%prep
%autosetup -n rstr-231837460e6eb5522884117dc38311a374b36012

%build
# The fixed official tag is pinned; the Git-less archive needs this
# supported setuptools_scm version input, not a guessed SCM version.
export SETUPTOOLS_SCM_PRETEND_VERSION_FOR_RSTR=%{version}
python3 -m pip wheel --no-build-isolation --no-deps --no-index --wheel-dir dist .

%install
python3 -m pip install --no-index --no-deps --no-compile --root %{buildroot} --prefix %{_prefix} dist/rstr-%{version}-py3-none-any.whl
install -d %{buildroot}%{_datadir}/%{name}/tests %{buildroot}%{_datadir}/%{name}/reference/rstr
# The complete four original tests and three modules plus marker, without
# generated bytecode or build output. No upstream test/fixture is excluded.
install -m 0644 tests/*.py %{buildroot}%{_datadir}/%{name}/tests/
install -m 0644 rstr/*.py rstr/py.typed %{buildroot}%{_datadir}/%{name}/reference/rstr/
install -m 0644 pyproject.toml tox.ini %{buildroot}%{_datadir}/%{name}/

%check
# The two whole original tox gates: no narrowed tests, new ignores, or
# edits to the upstream development-environment mypy 1.6.0 pin.
PYTHONPATH=. python3 -m unittest
mypy --strict rstr

%files
%license LICENSE.txt
%doc README.rst AUTHORS RELEASE_NOTES
%{python3_sitelib}/rstr/
%{python3_sitelib}/rstr-*.dist-info/
%{_datadir}/%{name}/


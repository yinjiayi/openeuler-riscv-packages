+++ b/downstream/CMakeLists.txt
@@ -0,0 +1,11 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 yinjiayi
+cmake_minimum_required(VERSION 3.10)
+project(liquid_installed_consumer C)
+find_package(liquid 1.8.3 EXACT CONFIG REQUIRED)
+if(NOT TARGET liquid::liquid)
+    message(FATAL_ERROR "Missing original exported liquid::liquid target")
+endif()
+add_executable(consumer consumer.c)
+target_compile_features(consumer PRIVATE c_std_11)
+target_link_libraries(consumer PRIVATE liquid::liquid m)
diff --git a/downstream/run-originals.py b/downstream/run-originals.py
new file mode 100644
--- /dev/null
+++ b/downstream/run-originals.py
@@ -0,0 +1,75 @@
+#!/usr/bin/python3
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 yinjiayi
+"""Repeat unchanged original programs; no benchmark timing/performance claim."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+
+p = argparse.ArgumentParser()
+p.add_argument("--programs", type=Path, required=True)
+p.add_argument("--data", type=Path, required=True)
+p.add_argument("--output", type=Path, required=True)
+a = p.parse_args()
+programs = a.programs.resolve(strict=True)
+data = a.data.resolve(strict=True)
+a.output.mkdir(parents=True, exist_ok=False)
+out = a.output.resolve(strict=True)
+examples = (data / "examples.list").read_text().splitlines()
+names = (data / "registry-names.list").read_text().splitlines()
+assert len(examples) == len(set(examples)) == 191
+assert len(names) == len(set(names)) == 1349
+assert all(re.fullmatch(r"[A-Za-z0-9_]+", s) for s in examples + names)
+records = []
+def emit_log(name, path, returncode):
+    raw = path.read_bytes()
+    record = dict(name=name, returncode=returncode,
+                  log_sha256=hashlib.sha256(raw).hexdigest(), log_bytes=len(raw))
+    print("BEGIN ORIGINAL PROGRAM " + json.dumps(record, sort_keys=True), flush=True)
+    print(raw.decode("utf-8", errors="replace"), end="", flush=True)
+    print("\nEND ORIGINAL PROGRAM " + name, flush=True)
+    return record
+
+for name in examples:
+    cwd = out / name
+    cwd.mkdir()
+    binary = programs / "examples" / name
+    assert binary.is_file() and os.access(binary, os.X_OK)
+    with (cwd / "output.log").open("xb") as log:
+        result = subprocess.run([str(binary)], cwd=cwd, stdout=log,
+                                stderr=subprocess.STDOUT, check=False)
+    records.append(emit_log(name, cwd / "output.log", result.returncode))
+    if result.returncode:
+        raise SystemExit(f"Original example {name} failed: {result.returncode}")
+cwd = out / "autotest"
+cwd.mkdir()
+with (cwd / "output.log").open("xb") as log:
+    result = subprocess.run([str(programs / "xautotest"), "-o", "results.json"],
+                            cwd=cwd, stdout=log, stderr=subprocess.STDOUT,
+                            check=False)
+autotest_record = emit_log("autotest", cwd / "output.log", result.returncode)
+if result.returncode:
+    raise SystemExit(f"Original full autotest failed: {result.returncode}")
+r = json.loads((cwd / "results.json").read_text())
+assert r["pass"] is True and r["num_failed"] == 0 and r["num_checks"] > 0
+assert r["stop-on-fail"] is False
+rows = r["tests"]
+assert len(rows) == 1349 and [x["id"] for x in rows] == list(range(1349))
+assert [x["name"] for x in rows] == names
+assert all(x["pass"] is True and x["num_checks"] == x["num_passed"] for x in rows)
+assert sum(x["num_checks"] for x in rows) == r["num_checks"]
+log = re.sub(r"\x1b\[[0-9;]*m", "", (cwd / "output.log").read_text())
+assert len(re.findall(r"\bskip\s*:\s*0\b", log)) == 1
+summary = dict(original_examples=records, original_autotests=1349,
+               autotest_program=autotest_record,
+               original_checks=r["num_checks"], warnings=r["num_warnings"],
+               skipped=0, benchmark_built_but_not_timed=True,
+               downstream_consumer_is_separate=True)
+(out / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
+print("ORIGINAL TEST RECEIPT " + json.dumps(summary, sort_keys=True), flush=True)
+print(json.dumps({k: v for k, v in summary.items() if k != "original_examples"},
+                 sort_keys=True))
diff --git a/downstream/run-tests.sh b/downstream/run-tests.sh
new file mode 100755
--- /dev/null
+++ b/downstream/run-tests.sh
@@ -0,0 +1,41 @@
+#!/bin/bash
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 yinjiayi
+set -euo pipefail
+root=
+if [ "${1:-}" = --staged ]; then
+    [ "$#" -eq 2 ]
+    root=$2
+    [ -n "$root" ] && [ -d "$root/usr/lib64" ]
+elif [ "$#" -ne 0 ]; then
+    exit 2
+fi
+data="$root/usr/share/liquid-dsp/tests"
+programs="$root/usr/libexec/liquid-dsp"
+lib="$root/usr/lib64/libliquid.so.1.8.3"
+test -f "$lib"
+readelf -d "$lib" | grep -E 'SONAME.*\[libliquid\.so\.1\]'
+readelf -d "$lib" | grep -E 'NEEDED.*\[libfftw3f\.so\.3\]'
+test -f "$root/usr/share/liquid-dsp/corresponding-source/fftw-3.3.10-3.oe2403sp3.src.rpm"
+printf '%s  %s\n' \
+    f0ebf856e2a01df5c04e421e4e98e2cc0ab05ddac8d1ac69111effba7dbde195 \
+    "$root/usr/share/liquid-dsp/corresponding-source/fftw-3.3.10-3.oe2403sp3.src.rpm" | sha256sum -c -
+if [ -z "$root" ]; then
+    rpm -V liquid-dsp liquid-dsp-devel liquid-dsp-tests
+fi
+work=$(mktemp -d "${TMPDIR:-/tmp}/liquid-installed-qa.XXXXXXXX")
+printf 'Installed QA raw output directory: %s\n' "$work"
+export LD_LIBRARY_PATH="$root/usr/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
+python3 "$data/run-originals.py" --programs "$programs" --data "$data" --output "$work/originals"
+export PKG_CONFIG_LIBDIR="$root/usr/lib64/pkgconfig:$root/usr/share/pkgconfig"
+if [ -n "$root" ]; then
+    export PKG_CONFIG_SYSROOT_DIR="$root"
+fi
+test "$(pkg-config --modversion liquid-dsp)" = 1.8.3
+gcc -std=c11 -Wall -Wextra -Werror "$data/consumer.c" \
+    $(pkg-config --cflags --libs liquid-dsp) -lm -o "$work/consumer-pkgconfig"
+"$work/consumer-pkgconfig"
+cmake -S "$data" -B "$work/cmake" -Dliquid_DIR="$root/usr/lib64/cmake/liquid"
+cmake --build "$work/cmake"
+"$work/cmake/consumer"
+printf 'liquid-dsp: installed originals 191 + 1349, FFTW/SONAME/source, PC and CMake consumers passed\n'

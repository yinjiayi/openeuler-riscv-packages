From: openEuler RISC-V package maintenance
Subject: [PATCH] configure: declare generated C probes for modern compilers

The shipped Autoconf 2.13 script emits two compiler sanity probes without
a main return type and two ctype probes calling exit without stdlib.h.
Give the sanity probes an explicit standard signature and declare exit
in both repeated ctype checks.  Keep every probe, condition, compiler flag,
and configure result decision intact; do not regenerate the build system.

Source: patpadgett/corkscrew ae4802b09e1c022e416f9654970794fb9d7ac8a2
Upstream-Status: Not submitted
License: GPL-2.0-only (upstream-derived configure changes)

--- a/configure
+++ b/configure
@@ -906,7 +906,7 @@
 #line 907 "configure"
 #include "confdefs.h"
 
-main(){return(0);}
+int main(void){return(0);}
 EOF
 if { (eval echo configure:912: \"$ac_link\") 1>&5; (eval $ac_link) 2>&5; } && test -s conftest${ac_exeext}; then
   ac_cv_prog_cc_works=yes
@@ -1246,6 +1246,7 @@
 #line 1247 "configure"
 #include "confdefs.h"
 #include <ctype.h>
+#include <stdlib.h>
 #define ISLOWER(c) ('a' <= (c) && (c) <= 'z')
 #define TOUPPER(c) (ISLOWER(c) ? 'A' + ((c) - 'a') : (c))
 #define XOR(e, f) (((e) && !(f)) || (!(e) && (f)))
@@ -1450,7 +1451,7 @@
 #line 1451 "configure"
 #include "confdefs.h"
 
-main(){return(0);}
+int main(void){return(0);}
 EOF
 if { (eval echo configure:1456: \"$ac_link\") 1>&5; (eval $ac_link) 2>&5; } && test -s conftest${ac_exeext}; then
   ac_cv_prog_cc_works=yes
@@ -1995,6 +1996,7 @@
 #line 1996 "configure"
 #include "confdefs.h"
 #include <ctype.h>
+#include <stdlib.h>
 #define ISLOWER(c) ('a' <= (c) && (c) <= 'z')
 #define TOUPPER(c) (ISLOWER(c) ? 'A' + ((c) - 'a') : (c))
 #define XOR(e, f) (((e) && !(f)) || (!(e) && (f)))

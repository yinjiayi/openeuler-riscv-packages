From: yinjiayi <yinjiayi@users.noreply.github.com>
Subject: [PATCH] Add separately identified installed-interface probes

Stage the exact downstream MIT QA files through the declared patch series.
Original library, CLI source and all original fixtures/runner remain untouched.

--- /dev/null
+++ b/downstream/consumer.c
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: MIT
+ * Copyright (c) 2026 yinjiayi
+ * Downstream representative API checks, not the upstream test suite.
+ */
+#include <json.h>
+#include <stdio.h>
+#include <string.h>
+
+#define REQUIRE(x) do { if (!(x)) { fprintf(stderr, "check failed: %s\n", #x); return 1; } } while (0)
+struct events { unsigned count[JSON_NULL + 1]; };
+static int event(void *ctx, int type, const char *data, uint32_t len)
+{
+    struct events *e = ctx;
+    if (type < JSON_NONE || type > JSON_NULL) return 1;
+    e->count[type]++;
+    if (type == JSON_KEY && (len != 1 || data[0] != 'x')) return 1;
+    return 0;
+}
+struct output { char data[128]; size_t length; };
+static int output(void *ctx, const char *data, uint32_t len)
+{
+    struct output *o = ctx;
+    if (o->length + len >= sizeof(o->data)) return 1;
+    memcpy(o->data + o->length, data, len);
+    o->length += len; o->data[o->length] = 0;
+    return 0;
+}
+int main(void)
+{
+    static const char text[] = "{\"x\":[1,true,false,null,\"z\"]}";
+    json_parser p; struct events e = {{0}}; uint32_t used = 0;
+    REQUIRE(json_parser_init(&p, NULL, event, &e) == 0);
+    REQUIRE(json_parser_string(&p, text, 7, &used) == 0 && used == 7);
+    for (size_t i = 7; i < sizeof(text) - 1; ++i)
+        REQUIRE(json_parser_char(&p, (unsigned char)text[i]) == 0);
+    REQUIRE(json_parser_is_done(&p));
+    REQUIRE(e.count[JSON_OBJECT_BEGIN] == 1 && e.count[JSON_OBJECT_END] == 1);
+    REQUIRE(e.count[JSON_ARRAY_BEGIN] == 1 && e.count[JSON_ARRAY_END] == 1);
+    REQUIRE(e.count[JSON_KEY] == 1 && e.count[JSON_INT] == 1);
+    REQUIRE(e.count[JSON_TRUE] == 1 && e.count[JSON_FALSE] == 1);
+    REQUIRE(e.count[JSON_NULL] == 1 && e.count[JSON_STRING] == 1);
+    REQUIRE(json_parser_free(&p) == 0);
+    REQUIRE(json_parser_init(&p, NULL, NULL, NULL) == 0);
+    REQUIRE(!json_parser_is_done(&p));
+    REQUIRE(json_parser_string(&p, "{]", 2, &used) != 0);
+    REQUIRE(json_parser_free(&p) == 0);
+    json_printer pr; struct output o = {{0}, 0};
+    REQUIRE(json_print_init(&pr, output, &o) == 0);
+    REQUIRE(json_print_args(&pr, json_print_raw, JSON_OBJECT_BEGIN,
+                           JSON_KEY, "x", -1, JSON_INT, "1", -1,
+                           JSON_OBJECT_END, -1) == 0);
+    REQUIRE(strcmp(o.data, "{\"x\":1}") == 0);
+    REQUIRE(json_print_free(&pr) == 0);
+    puts("libjson downstream API checks passed");
+    return 0;
+}
--- /dev/null
+++ b/downstream/run-tests.sh
@@ -0,0 +1,61 @@
+#!/bin/bash
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 yinjiayi
+set -euo pipefail
+export LC_ALL=C
+prefix=${1:-}
+qa="$prefix/usr/share/libjson"
+lib="$prefix/usr/lib64"
+include="$prefix/usr/include"
+test -f "$include/json.h"
+test -f "$lib/libjson.a"
+test -f "$lib/libjson.so.0.8.0"
+test "$(readlink "$lib/libjson.so")" = libjson.so.0
+test "$(readlink "$lib/libjson.so.0")" = libjson.so.0.8
+test "$(readlink "$lib/libjson.so.0.8")" = libjson.so.0.8.0
+readelf -d "$lib/libjson.so.0.8.0" | grep -E 'SONAME.*libjson\.so\.0\.8\.0' >/dev/null
+ar t "$lib/libjson.a" | grep -Fx json.o >/dev/null
+(cd "$qa"; sha256sum -c SHA256SUMS)
+tmp=$(mktemp -d)
+trap 'rm -rf -- "$tmp"' EXIT
+export LD_LIBRARY_PATH="$lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
+export PKG_CONFIG_LIBDIR="$lib/pkgconfig"
+export PKG_CONFIG_SYSROOT_DIR="$prefix"
+test "$(pkg-config --modversion libjson)" = 0.8
+# The source copy is outside include/ so quoted json.h resolves to installed header.
+gcc -std=gnu99 -O2 -Wall -I"$include" "$qa/jsonlint.c" -L"$lib" -ljson -o "$tmp/jsonlint"
+gcc -std=c99 -O2 -Wall -Wextra "$qa/consumer.c" $(pkg-config --cflags --libs libjson) -o "$tmp/shared-consumer"
+gcc -std=c99 -O2 -Wall -Wextra -I"$include" "$qa/consumer.c" "$lib/libjson.a" -o "$tmp/static-consumer"
+"$tmp/shared-consumer"
+"$tmp/static-consumer"
+cp -R "$qa/tests" "$tmp/tests"
+chmod +x "$tmp/tests/runtest"
+# Keep original runner and fixtures byte-for-byte, but also enforce actual results.
+(cd "$tmp/tests"; ./runtest) > "$tmp/original-tests.log" 2>&1
+cat "$tmp/original-tests.log"
+if grep -F FAILED "$tmp/original-tests.log"; then exit 1; fi
+test "$(grep -c SUCCESS "$tmp/original-tests.log")" -eq 33
+good=0; bad=0
+for f in "$qa"/tests/good/*.json; do
+    "$prefix/usr/bin/jsonlint" --verify "$f"
+    "$tmp/jsonlint" --verify "$f"
+    good=$((good+1))
+done
+for f in "$qa"/tests/bad/*.json; do
+    for cli in "$prefix/usr/bin/jsonlint" "$tmp/jsonlint"; do
+        rc=0
+        "$cli" --verify "$f" || rc=$?
+        test "$rc" -eq 1
+    done
+    bad=$((bad+1))
+done
+test "$good" -eq 21
+test "$bad" -eq 12
+printf '{"x":[1,true,false,null,"z"]}\n' > "$tmp/sample.json"
+for cli in "$prefix/usr/bin/jsonlint" "$tmp/jsonlint"; do
+    "$cli" --format "$tmp/sample.json" > "$tmp/formatted.json"
+    "$cli" --verify "$tmp/formatted.json"
+    "$cli" --tree "$tmp/sample.json" > "$tmp/tree.txt"
+    test -s "$tmp/tree.txt"
+done
+printf 'libjson installed checks passed: original=33 good=21 bad=12 consumers=2\n'

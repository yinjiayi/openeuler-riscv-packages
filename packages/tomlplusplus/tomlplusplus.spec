%description
A header-only C++17 TOML parser and serializer. Install the complete original
CMake SDK layout, including its non-API include/meson.build, without inventing
a shared/static library, pkg-config file or CLI. Retain both original Linux
Meson development profiles and every registered locale invocation. Additional
strict consumers check the real installed CMake target and header contents.

%prep
%setup -q -n marzer-tomlplusplus-3017243
python3 - <<'TOMLPLUSPLUS_SNAPSHOT_PY'
import hashlib,json,pathlib,shutil
root=pathlib.Path('.')
original=sorted(p for p in root.rglob('*') if p.is_file())
assert len(original)==212 and not any(p.is_symlink() for p in original)
notices=pathlib.Path('source-notices');notices.mkdir()
lines=[]
for path in original:
    rel=path.as_posix();destination=notices/(rel+'.notice');destination.parent.mkdir(parents=True,exist_ok=True)
    raw=path.read_bytes();destination.write_bytes(raw);destination.chmod(0o644)
    lines.append(hashlib.sha256(raw).hexdigest()+'  '+rel+'.notice')
(notices/'SHA256SUMS').write_text('\n'.join(lines)+'\n')
assert len(lines)==212
TOMLPLUSPLUS_SNAPSHOT_PY

cat > packaging-qa/run-qa.sh <<'TOMLPLUSPLUS_EMBED_RUN_QA_SH'
#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 openEuler supplementary packaging contributors.
set -euo pipefail
test "$#" -eq 1
exec python3 - "$0" "$1" <<'TOMLPLUSPLUS_QA_PY'
import base64,hashlib,json,os,pathlib,re,shlex,subprocess,sys,tempfile
helper=pathlib.Path(sys.argv[1]).resolve(strict=True);qa=helper.parent;prefix=pathlib.Path(sys.argv[2]).resolve(strict=True)
assert prefix.is_absolute() and str(prefix).endswith('/usr')
sha=lambda b:hashlib.sha256(b).hexdigest()
expected_files={'consumer.cpp','CMakeLists.txt','run-qa.sh','expected.stdout','installed-source-manifest.json','SHA256SUMS'}
assert {p.name for p in qa.iterdir()}==expected_files and all(p.is_file() and not p.is_symlink() for p in qa.iterdir())
rows={}
for line in (qa/'SHA256SUMS').read_text().splitlines():
    digest,name=line.split('  ',1);assert re.fullmatch('[a-f0-9]{64}',digest) and name in expected_files-{'SHA256SUMS'} and name not in rows
    assert sha((qa/name).read_bytes())==digest;rows[name]=digest
assert set(rows)==expected_files-{'SHA256SUMS'}
manifest=json.loads((qa/'installed-source-manifest.json').read_bytes());assert len(manifest)==57 and len(set(r['path'] for r in manifest))==57
def snapshot():
    observed={}
    for row in manifest:
        rel=row['path'];assert not pathlib.PurePosixPath(rel).is_absolute() and '..' not in pathlib.PurePosixPath(rel).parts
        path=prefix/rel;assert path.is_file() and not path.is_symlink() and path.resolve(strict=True)==path
        b=path.read_bytes();assert len(b)==row['bytes'] and sha(b)==row['sha256'];observed[rel]=sha(b)
    for name in expected_files:
        path=qa/name;observed['QA/'+name]=sha(path.read_bytes())
    return observed
before=snapshot();records=[];work=pathlib.Path(tempfile.mkdtemp(prefix='tomlplusplus-consumer-'));(work/'home').mkdir()
env=dict(os.environ)
for key in list(env):
    if key in {'CPATH','CPLUS_INCLUDE_PATH','C_INCLUDE_PATH','CXXFLAGS','CPPFLAGS','LDFLAGS','LIBRARY_PATH','LD_LIBRARY_PATH','LD_PRELOAD','CMAKE_PREFIX_PATH','CMAKE_MODULE_PATH'} or key.startswith('CMAKE_FIND_'):env.pop(key)
env.update(LC_ALL='C',LANG='C',HOME=str(work/'home'))
def run(label,argv,ok=True,timeout=180):
    assert label not in {v['label'] for v in records}
    try:r=subprocess.run(argv,cwd=work,env=env,stdin=subprocess.DEVNULL,capture_output=True,timeout=timeout);code,out,err=r.returncode,r.stdout,r.stderr
    except subprocess.TimeoutExpired as ex:code,out,err=124,ex.stdout or b'',ex.stderr or b''
    row=dict(label=label,argv=argv,cwd=str(work),exit=code,stdout_sha256=sha(out),stderr_sha256=sha(err),stdout_base64=base64.b64encode(out).decode(),stderr_base64=base64.b64encode(err).decode(),stdout_bytes=len(out),stderr_bytes=len(err));records.append(row)
    (work/(label+'.stdout')).write_bytes(out);(work/(label+'.stderr')).write_bytes(err)
    assert code!=124 and (code==0 if ok else code!=0),(label,code)
    return out,err
try:
    positive=work/'positive';negative=work/'negative'

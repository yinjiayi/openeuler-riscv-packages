cat > packaging-qa/consumer.cpp <<'TOMLPLUSPLUS_EMBED_CONSUMER_CPP'
// SPDX-License-Identifier: Apache-2.0
// Copyright 2026 openEuler supplementary packaging contributors.
// Original tests are retained separately; six deterministic API groups only.
#include <toml++/toml.hpp>
#include <cstdint>
#include <iostream>
#include <limits>
#include <sstream>
#include <stdexcept>
#include <string>
static_assert(TOML_LIB_MAJOR == 3 && TOML_LIB_MINOR == 4 && TOML_LIB_PATCH == 0);
static void need(bool b, const char* why) { if (!b) throw std::runtime_error(why); }
int main() {
  try {
    auto scalars = toml::parse("answer = 42\nflag = true\nname = 'sdk'\n");
    need(scalars["answer"].value<std::int64_t>() == 42, "integer");
    need(scalars["flag"].value<bool>() == true, "boolean");
    need(scalars["name"].value<std::string>() == "sdk", "string");
    need(!scalars["missing"].value<std::string>().has_value(), "missing lookup");
    std::cout << "case 1 scalars and absent lookup OK\n";

    auto nested = toml::parse("[owner]\nname = 'TOML'\nvalues = [1, 2, 3]\n['quoted.key']\nvalue = 'caf\u00e9 \u4e2d'\n");
    need(nested["owner"]["name"].value<std::string>() == "TOML", "nested table");
    auto* array = nested["owner"]["values"].as_array();
    need(array && array->size() == 3 && (*array)[2].value<std::int64_t>() == 3, "array");
    need(nested["quoted.key"]["value"].value<std::string>() == "caf\u00e9 \u4e2d", "UTF-8 and literal key");
    std::cout << "case 2 nested array UTF-8 and quoted key OK\n";

    auto numbers = toml::parse("maximum = 9223372036854775807\nminimum = -9223372036854775808\nreal = 1.5\n");
    need(numbers["maximum"].value<std::int64_t>() == std::numeric_limits<std::int64_t>::max(), "max integer");
    need(numbers["minimum"].value<std::int64_t>() == std::numeric_limits<std::int64_t>::min(), "min integer");
    need(numbers["real"].is_floating_point() && numbers["real"].value<double>() == 1.5, "floating value");
    std::cout << "case 3 numeric type and int64 boundaries OK\n";

    auto dates = toml::parse("date = 2024-02-29\ntime = 12:34:56\nstamp = 2024-02-29T12:34:56Z\n");
    auto date = dates["date"].value<toml::date>();
    auto time = dates["time"].value<toml::time>();
    auto stamp = dates["stamp"].value<toml::date_time>();
    need(date && date->year == 2024 && date->month == 2 && date->day == 29, "date");
    need(time && time->hour == 12 && time->minute == 34 && time->second == 56, "time");
    need(stamp && stamp->date == *date && stamp->time == *time && stamp->offset.has_value(), "offset datetime");
    std::cout << "case 4 date time and offset datetime OK\n";

    bool rejected = false;
    try { (void)toml::parse("broken = [\n"); }
    catch (const toml::parse_error& error) {
      rejected = !error.description().empty() && error.source().begin.line >= 1;
    }
    need(rejected, "invalid TOML must report parse error");
    std::cout << "case 5 invalid TOML diagnostics OK\n";

    toml::table owned{{"title", "roundtrip"}, {"count", 7}};
    owned.insert_or_assign("count", 8);
    owned.insert("temporary", false);
    need(owned.erase("temporary") == 1 && !owned.contains("temporary"), "erase");
    std::ostringstream formatted;
    formatted << owned;
    auto roundtrip = toml::parse(formatted.str());
    need(roundtrip == owned && roundtrip["count"].value<std::int64_t>() == 8, "format/parse roundtrip");
    std::cout << "case 6 mutation formatting and roundtrip OK\n";
    return 0;
  } catch (const std::exception& error) {
    std::cerr << "owned consumer failure: " << error.what() << '\n';
    return 1;
  }
}

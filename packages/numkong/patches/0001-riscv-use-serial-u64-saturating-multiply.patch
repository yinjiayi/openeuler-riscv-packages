From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: openEuler RISC-V Package Automation <noreply@example.invalid>
Date: Sun, 6 Sep 2026 00:00:00 +0000
Subject: [PATCH] riscv: use serial 64-bit saturating multiply fallback

GCC 14 for RISC-V does not provide the vmulhu u64m1 intrinsic used by the
RVV scalar helpers.  Reuse NumKong's existing portable 64-bit implementations
for these two scalar operations while retaining the other RVV kernels.

Patch-Source: openEuler RISC-V review of the official 7.7.1 archive
Patch-License: Apache-2.0
Upstream-Status: Not Submitted (automated upstream writes forbidden)
Remove-When: An upstream release provides a GCC-compatible RVV implementation
 for 64-bit saturating multiplication.
---
 include/numkong/scalar/rvv.h | 16 ++--------------
 1 file changed, 2 insertions(+), 14 deletions(-)

diff --git a/include/numkong/scalar/rvv.h b/include/numkong/scalar/rvv.h
--- a/include/numkong/scalar/rvv.h
+++ b/include/numkong/scalar/rvv.h
@@ -177,22 +177,10 @@ NK_PUBLIC nk_i32_t nk_i32_saturating_mul_rvv(nk_i32_t a, nk_i32_t b) {
     return __riscv_vmv_x_s_i32m1_i32(__riscv_vnclip_wx_i32m1(product_i64m2, 0, __RISCV_VXRM_RDN, 1));
 }
 NK_PUBLIC nk_u64_t nk_u64_saturating_mul_rvv(nk_u64_t a, nk_u64_t b) {
-    vuint64m1_t a_u64m1 = __riscv_vmv_v_x_u64m1(a, 1);
-    vuint64m1_t b_u64m1 = __riscv_vmv_v_x_u64m1(b, 1);
-    nk_u64_t high = __riscv_vmv_x_s_u64m1_u64(__riscv_vmulhu_vv_u64m1(a_u64m1, b_u64m1, 1));
-    return high ? 18446744073709551615ull : (a * b);
+    return nk_u64_saturating_mul_serial(a, b);
 }
 NK_PUBLIC nk_i64_t nk_i64_saturating_mul_rvv(nk_i64_t a, nk_i64_t b) {
-    int sign = (a < 0) ^ (b < 0);
-    nk_u64_t abs_a = a < 0 ? (0u - (nk_u64_t)a) : (nk_u64_t)a;
-    nk_u64_t abs_b = b < 0 ? (0u - (nk_u64_t)b) : (nk_u64_t)b;
-    vuint64m1_t a_u64m1 = __riscv_vmv_v_x_u64m1(abs_a, 1);
-    vuint64m1_t b_u64m1 = __riscv_vmv_v_x_u64m1(abs_b, 1);
-    nk_u64_t high = __riscv_vmv_x_s_u64m1_u64(__riscv_vmulhu_vv_u64m1(a_u64m1, b_u64m1, 1));
-    nk_u64_t low = abs_a * abs_b;
-    if (high || (sign && low > 9223372036854775808ull) || (!sign && low > 9223372036854775807ull))
-        return sign ? (-9223372036854775807ll - 1ll) : 9223372036854775807ll;
-    return sign ? -(nk_i64_t)low : (nk_i64_t)low;
+    return nk_i64_saturating_mul_serial(a, b);
 }
 
 #if defined(__cplusplus)

From: openEuler RISC-V Maintainers <noreply@example.invalid>
Date: Sun, 6 Sep 2026 00:00:00 +0000
Subject: [PATCH] tests: accept stable release versions in approval filters

Stable tags report a three-component version such as 1.3.2, while the
approval-test filters only normalize four-component development versions.
Accept either form so the unchanged release output can be compared with the
version-independent approval fixtures.

Patch-Source: openEuler RISC-V review of the official snitch 1.3.2 tag
Patch-License: BSL-1.0
Upstream-Status: Not Submitted (automated upstream writes forbidden)
Remove-When: An upstream release normalizes three-component stable versions
 in the approval tests.
---
 tests/approval_tests/reporter_catch2_xml.cpp | 2 +-
 tests/approval_tests/reporter_console.cpp    | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/tests/approval_tests/reporter_catch2_xml.cpp b/tests/approval_tests/reporter_catch2_xml.cpp
--- a/tests/approval_tests/reporter_catch2_xml.cpp
+++ b/tests/approval_tests/reporter_catch2_xml.cpp
@@ -37,7 +37,7 @@ TEST_CASE("xml reporter", "[reporters]") {
 
     const std::vector<std::regex> ignores = {
         std::regex{R"|(durationInSeconds="([0-9.e+\-]{12})")|"},
-        std::regex{R"(catch2-version="([0-9]+\.[0-9]+\.[0-9]+\.[0-9a-z]+).snitch)"},
+        std::regex{R"(catch2-version="([0-9]+\.[0-9]+\.[0-9]+(?:\.[0-9a-z]+)?).snitch)"},
         std::regex{R"(filename="(.+/snitch/tests/approval_tests/))"},
         std::regex{R"(filename="(.+/snitch/tests/))"},
         std::regex{R"(<File>(.+/snitch/tests/approval_tests/))"},
diff --git a/tests/approval_tests/reporter_console.cpp b/tests/approval_tests/reporter_console.cpp
--- a/tests/approval_tests/reporter_console.cpp
+++ b/tests/approval_tests/reporter_console.cpp
@@ -22,7 +22,7 @@ TEST_CASE("console reporter", "[reporters]") {
 
     const std::vector<std::regex> ignores = {
         std::regex{R"(, ([0-9.e+\-]{12}) seconds)"},
-        std::regex{R"(snitch v([0-9]+\.[0-9]+\.[0-9]+\.[0-9a-z]+))"},
+        std::regex{R"(snitch v([0-9]+\.[0-9]+\.[0-9]+(?:\.[0-9a-z]+)?))"},
         std::regex{R"(at (.+/snitch/tests/approval_tests/).+:([0-9]+))"},
         std::regex{R"(at (.+/snitch/tests/).+:([0-9]+))"},
         std::regex{R"(at (.+\\snitch\\tests\\approval_tests\\).+:([0-9]+))"},
-- 
2.50.1

From: openEuler RISC-V Maintainers <noreply@example.invalid>
Subject: [PATCH] Stabilize single-precision DSP tests

The NCQO mean checks used the library's 1e-15 threshold even when SUFLOAT is
float, which is much smaller than float precision after accumulating 131072
samples. Give only those zero-mean assertions a single-precision-appropriate
tolerance. Seed the detector tests independently so their noise vectors do
not depend on which earlier tests ran. Finally, validate the processed AGC
output instead of the unprocessed falling-amplitude input.

These changes retain all 18 upstream tests and their functional assertions.

--- a/src/tests/agc.c
+++ b/src/tests/agc.c
@@ -270,7 +270,7 @@
   /* TODO: Improve levels */
   SU_TEST_ASSERT(su_test_check_peak(
       ctx,
-      input,
+      output,
       ctx->params->buffer_size,
       2 * SU_TEST_AGC_WINDOW,
       SU_AGC_RESCALE * 0.9,
--- a/src/tests/detect.c
+++ b/src/tests/detect.c
@@ -102,6 +102,9 @@
       su_iir_brickwall_init(&mf, filter_period, SU_TEST_COSTAS_BANDWIDTH));
 #endif
 
+  /* Keep the synthetic noise independent from earlier tests in the suite. */
+  srand(1);
+
   /* Create QPSK signal */
   msgbuf = message;
   SU_INFO("Modulating 0x%x in QPSK...\n", msgbuf);
--- a/src/tests/ncqo.c
+++ b/src/tests/ncqo.c
@@ -30,6 +30,12 @@
 #include "test_list.h"
 #include "test_param.h"
 
+#ifdef _SU_SINGLE_PRECISION
+#  define SU_TEST_MEAN_TOLERANCE 1e-6f
+#else
+#  define SU_TEST_MEAN_TOLERANCE 1e-12
+#endif
+
 SUBOOL
 su_test_ncqo(su_test_context_t *ctx)
 {
@@ -48,9 +54,9 @@
   for (p = 0; p < SU_TEST_SIGNAL_BUFFER_SIZE; ++p)
     buffer[p] = su_ncqo_read_i(&ncqo);
 
-  SU_TEST_ASSERT(SUFLOAT_EQUAL(
+  SU_TEST_ASSERT(sufeq(
       su_test_buffer_mean(buffer, SU_TEST_SIGNAL_BUFFER_SIZE),
-      0));
+      0, SU_TEST_MEAN_TOLERANCE));
 
   SU_TEST_ASSERT(
       SUFLOAT_EQUAL(su_test_buffer_pp(buffer, SU_TEST_SIGNAL_BUFFER_SIZE), 2));
@@ -59,9 +65,9 @@
   for (p = 0; p < SU_TEST_SIGNAL_BUFFER_SIZE; ++p)
     buffer[p] = su_ncqo_read_q(&ncqo);
 
-  SU_TEST_ASSERT(SUFLOAT_EQUAL(
+  SU_TEST_ASSERT(sufeq(
       su_test_buffer_mean(buffer, SU_TEST_SIGNAL_BUFFER_SIZE),
-      0));
+      0, SU_TEST_MEAN_TOLERANCE));
 
   SU_TEST_ASSERT(
       SUFLOAT_EQUAL(su_test_buffer_pp(buffer, SU_TEST_SIGNAL_BUFFER_SIZE), 0));
@@ -73,9 +79,9 @@
   for (p = 0; p < SU_TEST_SIGNAL_BUFFER_SIZE; ++p)
     buffer[p] = su_ncqo_read_i(&ncqo);
 
-  SU_TEST_ASSERT(SUFLOAT_EQUAL(
+  SU_TEST_ASSERT(sufeq(
       su_test_buffer_mean(buffer, SU_TEST_SIGNAL_BUFFER_SIZE),
-      0));
+      0, SU_TEST_MEAN_TOLERANCE));
 
   SU_TEST_ASSERT(
       SUFLOAT_EQUAL(su_test_buffer_pp(buffer, SU_TEST_SIGNAL_BUFFER_SIZE), 0));
@@ -84,9 +90,9 @@
   for (p = 0; p < SU_TEST_SIGNAL_BUFFER_SIZE; ++p)
     buffer[p] = su_ncqo_read_q(&ncqo);
 
-  SU_TEST_ASSERT(SUFLOAT_EQUAL(
+  SU_TEST_ASSERT(sufeq(
       su_test_buffer_mean(buffer, SU_TEST_SIGNAL_BUFFER_SIZE),
-      0));
+      0, SU_TEST_MEAN_TOLERANCE));
 
   SU_TEST_ASSERT(
       SUFLOAT_EQUAL(su_test_buffer_pp(buffer, SU_TEST_SIGNAL_BUFFER_SIZE), 2));

#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Aggregate factual package/PR/check/update data into a static GitHub Pages site."""

from __future__ import annotations

import argparse
import runpy
import pathlib
import re
import shutil
import subprocess
import urllib.parse
from typing import Any, Dict, Iterable, List, Mapping, Optional, Sequence, Tuple

from _lib import SCHEMA_VERSION, ToolError, atomic_write_json, atomic_write_text, emit_json, isoformat, load_json, parse_now, run_main, stable_json


VALID_STATES = {
    "discovered",
    "pr-open",
    "ci-queued",
    "building",
    "repair-queued",
    "codex-repairing",
    "failed",
    "needs-native-riscv",
    "needs-human",
    "passed",
    "merged",
    "reviewed",
    "open-pr",
    "merged-pr",
    "managed",
    "build-succeeded",
    "published",
}
INVENTORY_STATES = {
    "discovered",
    "reviewed",
    "open-pr",
    "merged-pr",
    "managed",
    "build-succeeded",
    "published",
    "failed",
    "needs-native-riscv",
}
VALID_RISCV = {"unknown", "qemu-buildable", "native-verified", "patched-for-riscv", "qemu-limitation", "unsupported"}


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    result.add_argument("--repo-root", default=".")
    result.add_argument("--output-dir", required=True)
    result.add_argument("--github-state")
    result.add_argument("--build-results")
    result.add_argument("--build-history", help="validated package-build-history JSON; unavailable history is shown as a lower bound")
    result.add_argument("--published-state", help="checksum-verified live repository state/metadata/RPM+SRPM inventory")
    result.add_argument("--package-inventory", help="full package inventory JSON or JSON.GZ")
    result.add_argument("--update-summary")
    result.add_argument("--catalog-snapshot")
    result.add_argument("--now")
    result.add_argument("--output", help="optional generator summary JSON")
    return result


def labels(record: Mapping[str, Any]) -> List[str]:
    values: List[str] = []
    for item in record.get("labels", []):
        if isinstance(item, Mapping):
            item = item.get("name")
        if item:
            values.append(str(item))
    return values


def package_from_pr(pr: Mapping[str, Any], allow_unverified: bool = False) -> Optional[str]:
    paths = pr.get("actual_files", pr.get("files", []))
    if isinstance(paths, Mapping):
        paths = paths.get("nodes", [])
    ids = {match.group(1) for item in paths if (match := re.match(r"^packages/([^/]+)/", str(item.get("path") or item.get("filename") or "") if isinstance(item, Mapping) else str(item)))}
    if len(ids) == 1:
        return next(iter(ids))
    if len(ids) > 1:
        return None
    if "files" in pr or "actual_files" in pr:
        return None
    if not allow_unverified:
        return None
    if pr.get("package_id"):
        return str(pr["package_id"])
    for label in labels(pr):
        if label.startswith("package:"):
            return label.split(":", 1)[1]
    head_data = pr.get("head") if isinstance(pr.get("head"), Mapping) else {}
    head = str(pr.get("headRefName") or pr.get("head_ref") or head_data.get("ref") or "")
    match = re.match(r"(?:onboard|update|repair|golden)/([a-z0-9._+-]+?)(?:-[vV]?\d|$)", head)
    return match.group(1) if match else None


def complete_pr_identity(pr: Mapping[str, Any], package_id: str) -> bool:
    paths = pr.get("actual_files", pr.get("files"))
    complete = pr.get("actual_files_complete") is True or pr.get("files_complete") is True
    if isinstance(paths, Mapping):
        complete = paths.get("pageInfo", {}).get("hasNextPage") is False and paths.get("totalCount") == len(paths.get("nodes", []))
    return complete and package_from_pr(pr) == package_id


def github_prs(path: Optional[str]) -> List[Mapping[str, Any]]:
    if not path:
        return []
    document = load_json(path)
    if isinstance(document, list):
        return [item for item in document if isinstance(item, Mapping)]
    if not isinstance(document, Mapping):
        raise ToolError("github-state must be an object or array")
    for key in ("pull_requests", "prs", "items"):
        if isinstance(document.get(key), list):
            return [item for item in document[key] if isinstance(item, Mapping)]
    return []


def build_results(path: Optional[str]) -> Dict[str, Mapping[str, Any]]:
    if not path:
        return {}
    root = pathlib.Path(path)
    files = sorted(root.rglob("*.json")) if root.is_dir() else [root]
    result: Dict[str, Mapping[str, Any]] = {}
    for file in files:
        try:
            document = load_json(file)
        except ToolError:
            continue
        if not isinstance(document, Mapping):
            continue
        is_final_build = bool(document.get("package_id") and document.get("status") and document.get("checks"))
        if document.get("kind") not in {"build-result", "failure-classification"} and not is_final_build:
            continue
        package_id = document.get("package_id")
        if not package_id:
            continue
        prior = result.get(str(package_id))
        timestamp = str(document.get("finished_at") or document.get("completed_at") or document.get("generated_at") or "")
        prior_timestamp = str(prior.get("finished_at") or prior.get("completed_at") or prior.get("generated_at") or "") if prior else ""
        if not prior or timestamp >= prior_timestamp:
            result[str(package_id)] = document
    return result


def publication_evidence(path: Optional[str]) -> Dict[str, List[Dict[str, Mapping[str, Any]]]]:
    """Pair staged filenames with commit-bound verification by generation."""
    grouped: Dict[Tuple[str, str, str], Dict[str, Mapping[str, Any]]] = {}
    if not path:
        return {}
    root = pathlib.Path(path)
    files = sorted(root.rglob("*.json")) if root.is_dir() else [root]
    for file in files:
        try:
            document = load_json(file)
        except ToolError:
            continue
        if not isinstance(document, Mapping):
            continue
        package_id = document.get("package_id")
        if not package_id:
            continue
        package = str(package_id)
        kind = str(document.get("kind") or "")
        if kind not in {"rpm-repository-publication-verification", "rpm-repository-upload-batch"}:
            continue
        generation = str(document.get("generation") or "")
        commit_sha = str(document.get("commit_sha") or "")
        if not generation or not re.fullmatch(r"[a-f0-9]{40}", commit_sha):
            continue
        bucket = grouped.setdefault((package, generation, commit_sha), {})
        bucket["verification" if "verification" in kind else "upload"] = document
    result: Dict[str, List[Dict[str, Mapping[str, Any]]]] = {}
    for (package, _generation, _commit), pair in grouped.items():
        if "upload" in pair and "verification" in pair:
            result.setdefault(package, []).append(pair)
    for pairs in result.values():
        pairs.sort(key=lambda pair: str(pair["verification"].get("verified_at") or ""), reverse=True)
    return result


def run_id_from_build(build: Optional[Mapping[str, Any]]) -> Optional[str]:
    if not build:
        return None
    job_id = str(build.get("job_id") or "")
    match = re.match(r"(\d+)(?::|$)", job_id)
    return match.group(1) if match else None


def run_url(build: Optional[Mapping[str, Any]]) -> Optional[str]:
    run_id = run_id_from_build(build)
    return "https://github.com/yinjiayi/openeuler-riscv-packages/actions/runs/%s" % run_id if run_id else None


def published_links(
    package_id: str,
    publication: Optional[Sequence[Mapping[str, Mapping[str, Any]]]],
) -> Dict[str, Any]:
    """Retained envelopes alone do not verify every public artifact byte."""
    return {"rpm": [], "srpm": [], "state": None, "commit_sha": None, "generation": None, "verified_at": None}


def pr_checks(pr: Mapping[str, Any]) -> List[Mapping[str, Any]]:
    checks = list(pr.get("statusCheckRollup") or pr.get("checks") or pr.get("check_runs") or [])
    checks.extend({"name": item.get("context"), "conclusion": item.get("state"), "status": item.get("state")} for item in pr.get("status_contexts", []) if isinstance(item, Mapping))
    return checks


def pr_state(pr: Mapping[str, Any]) -> str:
    pr_labels = set(labels(pr))
    if pr.get("mergedAt") or pr.get("merged_at") or str(pr.get("state", "")).lower() == "merged" or pr.get("merged") is True:
        return "merged"
    for state in ("needs-human", "needs-native-riscv", "codex-repairing", "repair-queued"):
        if state in pr_labels:
            return state
    checks = pr_checks(pr)
    conclusions: List[str] = []
    statuses: List[str] = []
    for check in checks:
        if not isinstance(check, Mapping):
            continue
        conclusion = check.get("conclusion")
        status = check.get("status") or check.get("state")
        if conclusion:
            conclusions.append(str(conclusion).lower())
        if status:
            statuses.append(str(status).lower())
    if any(value in {"failure", "failed", "cancelled", "timed_out", "action_required"} for value in conclusions):
        return "failed"
    if any(value in {"in_progress", "running"} for value in statuses):
        return "building"
    if any(value in {"queued", "pending", "requested", "waiting"} for value in statuses):
        return "ci-queued"
    if checks and conclusions and all(value in {"success", "neutral", "skipped"} for value in conclusions):
        return "passed"
    return "pr-open"


def current_pr_success_checks(pr: Mapping[str, Any]) -> bool:
    checks = pr_checks(pr)
    names = {str(check.get("name")): str(check.get("conclusion") or "").lower() for check in checks if isinstance(check, Mapping)}
    return pr.get("checks_complete") is True and pr.get("snapshot_head_current") is True and pr_state(pr) == "passed" and all(names.get(name) == "success" for name in ("rpmbuild-riscv64", "rpm-install-smoke"))


def latest_prs(prs: Iterable[Mapping[str, Any]]) -> Dict[str, Mapping[str, Any]]:
    result: Dict[str, Mapping[str, Any]] = {}
    for pr in prs:
        package_id = pr.get("package_id") or package_from_pr(pr)
        if not package_id:
            continue
        prior = result.get(package_id)
        timestamp = str(pr.get("updatedAt") or pr.get("updated_at") or pr.get("createdAt") or "")
        prior_time = str(prior.get("updatedAt") or prior.get("updated_at") or prior.get("createdAt") or "") if prior else ""
        is_open = str(pr.get("state") or "").lower() in {"open", "opened"}
        prior_open = bool(prior and str(prior.get("state") or "").lower() in {"open", "opened"})
        if not prior or (is_open and not prior_open) or (is_open == prior_open and timestamp >= prior_time):
            result[package_id] = pr
    return result


def pr_head(pr: Optional[Mapping[str, Any]]) -> str:
    if not pr:
        return ""
    head = pr.get("head") if isinstance(pr.get("head"), Mapping) else {}
    return str(pr.get("headRefOid") or pr.get("head_sha") or head.get("sha") or "")


def pr_url(pr: Optional[Mapping[str, Any]]) -> Optional[str]:
    if not pr:
        return None
    value = pr.get("url") or pr.get("html_url")
    return str(value) if value else None


def http_link(value: Any) -> Optional[str]:
    if not value:
        return None
    text = str(value)
    parsed = urllib.parse.urlparse(text)
    return text if parsed.scheme in {"http", "https"} and bool(parsed.netloc) else None


def verified_build(entry: Optional[Mapping[str, Any]], pr: Optional[Mapping[str, Any]], build: Optional[Mapping[str, Any]]) -> Optional[Mapping[str, Any]]:
    """Reject stale package build results that cannot be tied to a recorded head."""
    if not build:
        return None
    commit = str(build.get("commit_sha") or "")
    expected = {pr_head(pr)} if pr else set()
    if not pr and entry:
        recorded = latest_recorded_pr(entry)
        expected.add(pr_head(recorded))
    # A collector's live-main binding is useful only without a conflicting PR.
    if not pr and build.get("latest_head_verified") is True and re.fullmatch(r"[a-f0-9]{40}", commit):
        return build
    return build if commit and commit in expected else None


def update_entries(summary: Mapping[str, Any]) -> Dict[str, Mapping[str, Any]]:
    entries = summary.get("entries", []) if isinstance(summary, Mapping) else []
    return {str(item["package_id"]): item for item in entries if isinstance(item, Mapping) and item.get("package_id")}


def patch_count(package_dir: pathlib.Path) -> int:
    series = package_dir / "patches" / "series"
    if not series.exists():
        return len(list((package_dir / "patches").glob("*.patch"))) if (package_dir / "patches").is_dir() else 0
    return sum(1 for line in series.read_text(encoding="utf-8").splitlines() if line.strip() and not line.lstrip().startswith("#"))


def package_row(
    root: pathlib.Path,
    package_dir: pathlib.Path,
    metadata: Mapping[str, Any],
    entry: Optional[Mapping[str, Any]],
    pr: Optional[Mapping[str, Any]],
    build: Optional[Mapping[str, Any]],
    update: Optional[Mapping[str, Any]],
    publication: Optional[Sequence[Mapping[str, Mapping[str, Any]]]],
) -> Dict[str, Any]:
    package_id = str(metadata.get("package_id") or package_dir.name)
    build = verified_build(entry, pr, build)
    published = published_links(package_id, publication)
    rpm = metadata.get("rpm") if isinstance(metadata.get("rpm"), Mapping) else {}
    version_data = metadata.get("version") if isinstance(metadata.get("version"), Mapping) else {}
    current_version = str(version_data.get("current") or metadata.get("version") or "unknown")
    latest_value = update.get("latest_version") if update else version_data.get("latest_detected")
    latest_version = str(latest_value) if latest_value not in (None, "") else None
    state = str(entry.get("status")) if entry and entry.get("status") in INVENTORY_STATES else "managed"
    # The committed inventory is a snapshot. A package directory on current main
    # is stronger evidence than its older discovered/reviewed catalog status.
    if state in {"discovered", "reviewed"}:
        state = "managed"
    if pr and str(pr.get("state") or "").lower() in {"open", "opened"}:
        state = pr_state(pr)
    if build and not pr:
        status = str(build.get("status"))
        if build.get("recommended_state") in VALID_STATES:
            state = str(build["recommended_state"])
        elif status == "passed":
            state = "passed"
        elif status == "failed":
            state = "failed"
    if published["rpm"] and published["srpm"]:
        state = "published"
    elif build and build.get("status") == "passed" and not (pr and str(pr.get("state") or "").lower() in {"open", "opened"} and pr_state(pr) != "passed"):
        state = "build-succeeded"
    if state not in VALID_STATES:
        state = "failed"
    riscv_meta = metadata.get("riscv") if isinstance(metadata.get("riscv"), Mapping) else {}
    target = metadata.get("target") if isinstance(metadata.get("target"), Mapping) else {}
    riscv = str(target.get("riscv_status") or riscv_meta.get("status") or "unknown")
    patches = patch_count(package_dir)
    if state == "needs-native-riscv":
        riscv = "qemu-limitation"
    elif state in {"passed", "merged", "build-succeeded", "published"} and riscv == "unknown":
        riscv = "patched-for-riscv" if patches else "qemu-buildable"
    if riscv not in VALID_RISCV:
        riscv = "unknown"
    lineage = metadata.get("discovery", {}).get("lineage", []) if isinstance(metadata.get("discovery"), Mapping) else []
    sources = sorted({str(item.get("source")) for item in lineage if isinstance(item, Mapping) and item.get("source")})
    failure_category = None
    last_error = None
    if build:
        classification = build.get("classification")
        failure_category = classification.get("category") if isinstance(classification, Mapping) else (str(classification) if classification not in (None, "none") else None)
        failure = build.get("failure") if isinstance(build.get("failure"), Mapping) else {}
        last_error = failure.get("first_effective_error") or failure.get("message")
    updates_meta = metadata.get("updates") if isinstance(metadata.get("updates"), Mapping) else {}
    return {
        "package_id": package_id,
        "name": rpm.get("name") or metadata.get("rpm_name") or package_id,
        "current_version": current_version,
        "latest_upstream_version": latest_version,
        "last_successful_upstream_check_at": update.get("checked_at") if update and update.get("status") not in {"failed", "update-needs-source-verification"} else updates_meta.get("last_successful_check_at") or metadata.get("last_upstream_check"),
        "sources": sources,
        "status": state,
        "last_build_at": (build.get("finished_at") or build.get("completed_at") or build.get("generated_at")) if build else published["verified_at"],
        "riscv_status": riscv,
        "patch_count": patches,
        "failure_category": failure_category,
        "last_error": str(last_error)[:1000] if last_error else None,
        "updated_at": max(
            [str(value) for value in (updates_meta.get("last_checked_at"), metadata.get("last_upstream_check"), update.get("checked_at") if update else None, pr.get("updatedAt") if pr else None, pr.get("updated_at") if pr else None, build.get("finished_at") if build else None, published["verified_at"]) if value]
            or ["1970-01-01T00:00:00Z"]
        ),
        "links": {
            "package": "https://github.com/yinjiayi/openeuler-riscv-packages/tree/main/packages/%s" % package_id,
            "pr": pr_url(pr),
            "ci": run_url(build) or (pr.get("checks_url") if pr else None),
            "logs": build.get("log_url") if build else None,
            "rpm": published["rpm"],
            "srpm": published["srpm"],
            "publication": published["state"],
        },
    }


def latest_recorded_pr(entry: Mapping[str, Any]) -> Optional[Mapping[str, Any]]:
    candidates = [item for item in entry.get("pull_requests", []) if isinstance(item, Mapping)]
    return max(candidates, key=lambda item: str(item.get("updated_at") or item.get("created_at") or "")) if candidates else None


def select_pr(entry: Mapping[str, Any], live: Optional[Mapping[str, Any]]) -> Optional[Mapping[str, Any]]:
    recorded = latest_recorded_pr(entry)
    if not live:
        return recorded
    live_time = str(live.get("updatedAt") or live.get("updated_at") or live.get("createdAt") or "")
    recorded_time = str(recorded.get("updated_at") or recorded.get("created_at") or "") if recorded else ""
    return live if live_time >= recorded_time else recorded


def inventory_row(
    entry: Mapping[str, Any],
    live_pr: Optional[Mapping[str, Any]],
    build: Optional[Mapping[str, Any]],
    publication: Optional[Sequence[Mapping[str, Mapping[str, Any]]]],
) -> Dict[str, Any]:
    managed = entry.get("managed_package") if isinstance(entry.get("managed_package"), Mapping) else {}
    reviewed = entry.get("reviewed_release") if isinstance(entry.get("reviewed_release"), Mapping) else {}
    names = sorted({str(value) for value in entry.get("names", []) if value})
    package_id = str(managed.get("package_id") or entry.get("discovery_key") or (names[0] if names else "unknown"))
    pr = select_pr(entry, live_pr)
    build = verified_build(entry, pr, build)
    published = published_links(package_id, publication)
    status = str(entry.get("status") or "discovered")
    if pr and str(pr.get("state") or "").lower() in {"open", "opened"}:
        status = pr_state(pr)
    if build:
        build_status = str(build.get("status") or "")
        if build_status == "passed" and not (pr and str(pr.get("state") or "").lower() in {"open", "opened"} and pr_state(pr) != "passed"):
            status = "build-succeeded"
        elif build_status == "needs-native-riscv":
            status = "needs-native-riscv"
        elif build_status == "failed":
            status = "failed"
    if published["rpm"] and published["srpm"]:
        status = "published"
    if status not in VALID_STATES:
        status = "failed"
    stable_versions = [str(value) for value in entry.get("stable_versions", []) if value]
    version = str(managed.get("version") or reviewed.get("version") or (stable_versions[-1] if stable_versions else "unknown"))
    timestamps = [
        str(pr.get("updatedAt") or pr.get("updated_at") or "") if pr else "",
        str(build.get("finished_at") or build.get("completed_at") or build.get("generated_at") or "") if build else "",
        str(published["verified_at"] or ""),
    ]
    upstream_urls = [link for value in entry.get("upstream_urls", []) if (link := http_link(value))]
    row: Dict[str, Any] = {
        "inventory_id": str(entry.get("discovery_key") or package_id),
        "name": names[0] if names else package_id,
        "version": version,
        "status": status,
    }
    optional = {
        "package_id": str(managed.get("package_id")) if managed.get("package_id") else None,
        "aliases": names[1:] or None,
        "component_ids": sorted({str(value) for value in entry.get("component_ids", []) if value}) or None,
        "summary": str(managed.get("summary")) if managed.get("summary") else None,
        "decisions": sorted(str(key) for key in entry.get("decisions", {}) if key) or None,
        "updated_at": max((value for value in timestamps if value), default=None),
    }
    row.update({key: value for key, value in optional.items() if value is not None})
    links = {
        "package": "https://github.com/yinjiayi/openeuler-riscv-packages/tree/main/%s" % managed["directory"] if managed.get("directory") else None,
        "pr": http_link(pr_url(pr)),
        "ci": http_link(run_url(build)),
        "upstream": upstream_urls[0] if upstream_urls else None,
        "rpm": published["rpm"] or None,
        "srpm": published["srpm"] or None,
        "publication": http_link(published["state"]),
    }
    if any(value is not None for value in links.values()):
        row["links"] = {key: value for key, value in links.items() if value is not None}
    return row


def default_catalog(root: pathlib.Path) -> Mapping[str, Any]:
    snapshots = sorted((root / "catalog" / "snapshots").glob("*.json")) if (root / "catalog" / "snapshots").is_dir() else []
    return load_json(snapshots[-1]) if snapshots else {}


def copy_assets(root: pathlib.Path, output: pathlib.Path) -> None:
    source = root / "dashboard"
    for name in ("index.html", "app.js", "styles.css"):
        asset = source / name
        if not asset.is_file():
            raise ToolError("dashboard source asset is missing: %s" % asset)
        destination = output / name
        if asset.resolve() != destination.resolve():
            destination.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(asset, destination)


def load_history(path: Optional[str]) -> Mapping[str, Any]:
    if not path:
        return {"observations": [], "snapshot": {"coverage_complete": False, "lower_bound": True, "reasons": ["build-history input unavailable"], "cutoff": None}, "generated_at": None}
    document = load_json(path)
    schema_path = pathlib.Path(__file__).resolve().parent.parent / "schemas" / "build-history.schema.json"
    if not schema_path.is_file():
        raise ToolError("package-build-history schema is unavailable")
    validator = runpy.run_path(str(pathlib.Path(__file__).resolve().parent / "validate-metadata"))["schema_errors"]
    schema = load_json(schema_path)
    errors = validator(document, schema, schema)
    if errors:
        raise ToolError("build-history input-invalid: " + "; ".join(errors[:10]))
    if document["repository"] != "yinjiayi/openeuler-riscv-packages":
        raise ToolError("build-history repository identity mismatch")
    observed_summary = {
        "distinct_package_count": len({item["package_id"] for item in document["observations"]}),
        "distinct_recipe_count": len({(item["package_id"], item["recipe_tree_sha"]) for item in document["observations"]}),
        "success_tuple_count": len(document["observations"]),
    }
    # Durable public seeds must satisfy the collector's merge_seed entry point,
    # not only its summary validator. Browser view inputs may still deduplicate.
    if document["summary"] != observed_summary:
        raise ToolError("build-history summary disagrees with actual observations")
    if len({item["id"] for item in document["observations"]}) != len(document["observations"]):
        raise ToolError("duplicate build-history seed observations")
    if document["snapshot"]["coverage_complete"] == document["snapshot"]["lower_bound"]:
        raise ToolError("build-history completeness/lower-bound conflict")
    if document["snapshot"]["coverage_complete"] and document["snapshot"]["unresolved_count"]:
        raise ToolError("complete build-history has unresolved attempts")
    seen_attempts = set()
    for attempt in document["attempts"]:
        identity = "%s:%s:%s" % (attempt["run_id"], attempt["run_attempt"], attempt["head_sha"])
        if attempt["id"] != identity or identity in seen_attempts:
            raise ToolError("build-history checkpoint identity conflict")
        seen_attempts.add(identity)
        if attempt["status"] == "success" and not any(item["run_id"] == attempt["run_id"] and item["run_attempt"] == attempt["run_attempt"] and item.get("workflow_head_sha", item["head_sha"]) == attempt["head_sha"] for item in document["observations"]):
            raise ToolError("build-history success checkpoint has no successful observation")
        if (attempt["status"] == "not-successful" and not attempt["terminal"]) or (attempt["status"] == "pending" and attempt["terminal"]):
            raise ToolError("build-history checkpoint terminal status conflict")
        if attempt["status"] == "unresolved" and (not attempt["terminal"] or not attempt.get("reason")):
            raise ToolError("build-history unresolved checkpoint lacks terminal reason")
    for item in document["observations"]:
        if item["provenance"]["identity_method"] == "scope-log+exact-package-tree" and item["event"] != "workflow_dispatch":
            raise ToolError("build-history scoped whole-tree identity is only valid for dispatch")
        if item["provenance"]["identity_method"] == "legacy-workflow-contract+exact-package-tree":
            reviewed_contracts = {"729eb4d5b19325b09ab3f675c0725e54f18eb424d9a880a7df9910c49b9f9e75", "c240903907a69bb7b9de2bdb27ef991fef6b891c53113628823046bcb86b4747", "c25f7293303280b72e5f9c34d11279662bc0614600be4dd90f43878949f8ce30"}
            if item["event"] != "workflow_dispatch" or item["provenance"].get("workflow_contract_sha256") not in reviewed_contracts:
                raise ToolError("build-history legacy identity lacks reviewed dispatch workflow contract")
        if item["event"] == "workflow_dispatch" and (not re.fullmatch(r"[0-9a-f]{40}", item.get("workflow_head_sha", "")) or not (item["provenance"]["identity_method"] == "legacy-workflow-contract+exact-package-tree" or item["provenance"]["identity_method"].startswith("scope-log+"))):
            raise ToolError("dispatch history lacks distinct workflow/candidate scope identity")
        expected_id = "%s:%s:%s:%s" % (item["run_id"], item["run_attempt"], item["head_sha"], item["package_id"])
        if item["id"] != expected_id or item["recipe"]["ref"] != item["head_sha"] or item["run_url"] != "https://github.com/yinjiayi/openeuler-riscv-packages/actions/runs/%s" % item["run_id"]:
            raise ToolError("build-history exact observation identity mismatch")
        jobs = item["jobs"]
        if jobs["build"]["name"] != "rpmbuild-riscv64" or jobs["build"]["step_name"] not in {"Build SRPM and RPM without network", "Build SRPM and RPM with verified source networking"} or jobs["smoke"]["name"] != "rpm-install-smoke" or jobs["smoke"]["step_name"] != "Install RPM and run smoke test" or jobs["build"]["id"] == jobs["smoke"]["id"]:
            raise ToolError("build-history successful RPM/smoke step identity mismatch")
        times = [parse_now(jobs[k]["completed_at"]) for k in ("build", "smoke")]
        if parse_now(item["created_at"]) > min(times) or parse_now(item["completed_at"]) != max(times) or parse_now(item["completed_at"]) > parse_now(document["snapshot"]["cutoff"]):
            raise ToolError("build-history job/observation timestamp mismatch")
        if item["event"] in {"pull_request", "merge_group"} and any("self-hosted" in jobs[k]["runner_labels"] for k in ("build", "smoke")):
            raise ToolError("build-history PR self-hosted evidence is forbidden")
    return document


def load_published_state(path: Optional[str]) -> Tuple[Mapping[str, Any], Dict[str, Dict[str, Any]]]:
    if not path:
        return {}, {}
    document = load_json(path)
    schema_root = pathlib.Path(__file__).resolve().parent.parent / "schemas"
    schema = load_json(schema_root / "dashboard-published-state.schema.json")
    validator = runpy.run_path(str(pathlib.Path(__file__).resolve().parent / "validate-metadata"))["schema_errors"]
    errors = validator(document, schema, schema)
    if errors:
        raise ToolError("published-state input-invalid: " + "; ".join(errors[:10]))
    links: Dict[str, Dict[str, Any]] = {}
    generation = str(document["generation"])
    origin = "http://2.27.148.101:38080/generations/" + generation + "/"
    if document["generation_state_url"] != origin + "state.json":
        raise ToolError("publication generation state URL mismatch")
    for kind in ("riscv64", "source"):
        repository = document["repositories"][kind]
        metadata = document["metadata"][kind]
        primary_tail = metadata["primary_url"].removeprefix(repository["baseurl"] + "repodata/")
        if repository["baseurl"] != origin + kind + "/" or repository["repomd_sha256"] != document["verified_repomd_sha256"][kind] or metadata["repomd_sha256"] != repository["repomd_sha256"] or metadata["repomd_url"] != repository["baseurl"] + "repodata/repomd.xml" or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+-]*", primary_tail):
            raise ToolError("publication state/repomd/primary binding mismatch")
    verified_artifacts: Dict[str, Mapping[str, Any]] = {}
    for artifact in document["verified_artifacts"]:
        kind = "source" if artifact["arch"] in {"src", "nosrc"} else "riscv64"
        filename = artifact["filename"]
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+~-]*\.rpm", filename) or artifact["url"] != origin + kind + "/Packages/" + filename or artifact["url"] in verified_artifacts:
            raise ToolError("verified publication artifact URL is unsafe or duplicate")
        verified_artifacts[artifact["url"]] = artifact
    paired_artifacts: Dict[str, Mapping[str, Any]] = {}
    counts = {"source": 0, "riscv64": 0}
    for package in document.get("packages", []):
        package_id = str(package["package_id"])
        if package_id in links:
            raise ToolError("duplicate canonical package ID in published-state")
        rpm, srpm, timestamps = [], [], []
        for version in package.get("versions", []):
            source = version["source"]
            binaries = version["binaries"]
            if not binaries:
                raise ToolError("published source has no matching verified binary")
            for artifact, kind in [(source, "source"), *[(item, "riscv64") for item in binaries]]:
                filename = str(artifact["filename"])
                if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+~-]*\.rpm", filename) or artifact["url"] != origin + kind + "/Packages/" + filename:
                    raise ToolError("published artifact is outside the fixed immutable generation")
                if not re.fullmatch(r"[a-f0-9]{64}", str(artifact["sha256"])) or not isinstance(artifact["size"], int) or isinstance(artifact["size"], bool) or artifact["size"] <= 0:
                    raise ToolError("published artifact byte binding is invalid")
                if artifact["url"] in paired_artifacts:
                    raise ToolError("duplicate publication artifact URL")
                if verified_artifacts.get(artifact["url"]) != artifact:
                    raise ToolError("linked publication artifact is not an exact verified subset")
                if artifact["arch"] not in ({"src", "nosrc"} if kind == "source" else {"riscv64", "noarch"}):
                    raise ToolError("published artifact architecture mismatch")
                suffix = "-%s-%s.%s.rpm" % (version["version"], version["release"], artifact["arch"])
                if not filename.endswith(suffix) or (kind == "source" and filename != package["rpm_name"] + suffix):
                    raise ToolError("publication artifact/source EVR mismatch")
                paired_artifacts[artifact["url"]] = artifact
                counts[kind] += 1
                timestamps.append(artifact["verified_at"])
            srpm.append(source["url"])
            rpm.extend(item["url"] for item in binaries)
        if rpm and srpm:
            links[package_id] = {"rpm": sorted(set(rpm)), "srpm": sorted(set(srpm)), "state": origin + "state.json", "commit_sha": None, "generation": generation, "verified_at": max(timestamps), "versions": [{key: version[key] for key in ("epoch", "version", "release")} for version in package["versions"]]}
    coverage = document["coverage"]
    if not coverage["source_packages"] >= coverage["matched_packages"] >= coverage["verified_packages"] or (coverage["status"] == "partial" and not coverage["gaps"]):
        raise ToolError("publication coverage grain is inconsistent")
    if coverage["verified_packages"] != len(links) or coverage["verified_files"] != len(verified_artifacts) or coverage["verified_bytes"] != sum(item["size"] for item in verified_artifacts.values()):
        raise ToolError("publication verified coverage does not reconcile")
    if coverage["status"] == "complete" and (coverage["gaps"] or len(paired_artifacts) != len(verified_artifacts) or coverage["source_packages"] != len(links) or coverage["matched_packages"] != len(links) or coverage["rpm_files"] != counts["riscv64"] or coverage["srpm_files"] != counts["source"] or any(document["repositories"][kind]["rpm_count"] != counts[kind] or document["metadata"][kind]["package_count"] != counts[kind] for kind in counts)):
        raise ToolError("complete publication coverage does not reconcile")
    return document, links


class CanonicalPackages:
    """Exact, case-folded explicit aliases only; ambiguity never selects a winner."""

    def __init__(self) -> None:
        self.ids: set[str] = set()
        self.aliases: Dict[str, set[str]] = {}
        self.diagnostics: List[Dict[str, Any]] = []

    def add(self, package_id: str, aliases: Iterable[str]) -> None:
        if len(package_id) > 100 or not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", package_id):
            raise ToolError("invalid canonical package ID")
        self.ids.add(package_id)
        for name in [package_id, *aliases]:
            if name:
                self.aliases.setdefault(str(name).casefold(), set()).add(package_id)

    def resolve(self, names: Iterable[str]) -> Optional[str]:
        candidates: set[str] = set()
        for name in names:
            if name:
                candidates.update(self.aliases.get(str(name).casefold(), set()))
        return next(iter(candidates)) if len(candidates) == 1 else None

    def entry(self, entry: Mapping[str, Any]) -> Optional[str]:
        managed = entry.get("managed_package") or {}
        if managed.get("package_id") in self.ids:
            names = [entry.get("discovery_key"), *entry.get("names", []), *entry.get("aliases", []), *entry.get("component_ids", [])]
            other_ids = {identity for name in names if name for identity in self.aliases.get(str(name).casefold(), set()) if identity != managed["package_id"]}
            if other_ids:
                conflict = {"managed_package_id": managed["package_id"], "conflicting_package_ids": sorted(other_ids), "discovery_key": entry.get("discovery_key")}
                if conflict not in self.diagnostics:
                    self.diagnostics.append(conflict)
            return str(managed["package_id"])
        return self.resolve([entry.get("discovery_key"), *entry.get("names", []), *entry.get("aliases", []), *entry.get("component_ids", [])])


def metadata_aliases(metadata: Mapping[str, Any]) -> List[str]:
    aliases = [str(metadata.get("rpm", {}).get("name") or ""), str(metadata.get("upstream", {}).get("component") or "")]
    aliases.extend(str(value) for value in metadata.get("aliases", []) if value)
    # Lineage may describe a functional provider (e.g. Debianutils -> Which),
    # not an identity alias. Never turn that relationship into a join key.
    aliases.extend(str(value) for value in metadata.get("discovery_keys", []) if value)
    return aliases


def checked_recipe_trees(root: pathlib.Path, ids: Iterable[str]) -> Dict[str, Optional[str]]:
    """Only clean package trees from this actual checkout; no version-string guess."""
    result: Dict[str, Optional[str]] = {}
    for package_id in ids:
        dirty = subprocess.run(["git", "-C", str(root), "status", "--porcelain", "--untracked-files=all", "--", "packages/" + package_id], capture_output=True, text=True)
        tree = subprocess.run(["git", "-C", str(root), "rev-parse", "HEAD:packages/" + package_id], capture_output=True, text=True)
        value = tree.stdout.strip()
        result[package_id] = value if dirty.returncode == 0 and not dirty.stdout and tree.returncode == 0 and re.fullmatch(r"[a-f0-9]{40}", value) else None
    return result


def history_view(
    history: Mapping[str, Any], resolver: CanonicalPackages, metadata: Mapping[str, Mapping[str, Any]],
    trees: Mapping[str, Optional[str]], prs: Mapping[str, Mapping[str, Any]], builds: Mapping[str, Mapping[str, Any]],
    publications: Mapping[str, Any], published_state: Mapping[str, Any], github_state: Optional[Mapping[str, Any]] = None,
) -> Dict[str, Any]:
    records: Dict[str, Mapping[str, Any]] = {}
    duplicate_count = 0
    for item in history.get("observations", []):
        identity = str(item["id"])
        if identity in records:
            if stable_json(records[identity]) != stable_json(item):
                raise ToolError("conflicting build-history observation identity")
            duplicate_count += 1
        records[identity] = item
    by_package: Dict[str, List[Mapping[str, Any]]] = {}
    for item in records.values():
        if item.get("build_status") == "passed" and item.get("smoke_status") == "passed" and item.get("evidence_strength") == "hosted-step":
            by_package.setdefault(str(item["package_id"]), []).append(item)
    packages = []
    for package_id in sorted(resolver.ids):
        observations = sorted(by_package.get(package_id, []), key=lambda item: (str(item.get("completed_at") or ""), str(item["id"])))
        main = [item for item in observations if trees.get(package_id) and item.get("recipe_tree_sha") == trees[package_id] and item.get("event") in {"push", "workflow_dispatch"} and item.get("head_branch") == "main" and (item.get("event") != "workflow_dispatch" or item.get("workflow_head_sha") == item.get("head_sha"))]
        pr = prs.get(package_id)
        current_pr = [item for item in observations if pr and pr.get("canonical_identity_verified") is True and current_pr_success_checks(pr) and pr_head(pr) == item.get("head_sha") and str(pr.get("state") or "").lower() in {"open", "opened"}]
        main_status = "passed" if main else "unknown"
        pr_status = "passed" if current_pr else "unknown"
        if pr and pr_state(pr) in {"failed", "building", "ci-queued", "needs-human", "needs-native-riscv", "repair-queued", "codex-repairing"}:
            pr_status = pr_state(pr)
        build = builds.get(package_id)
        if build and build.get("status") == "failed" and trees.get(package_id) and build.get("recipe_tree_sha") == trees[package_id] and build.get("head_branch") == "main":
            main_status = "failed"
        published = publications.get(package_id) or published_links(package_id, None)
        latest = observations[-1] if observations else None
        packages.append({
            "package_id": package_id, "name": metadata.get(package_id, {}).get("rpm", {}).get("name") or package_id,
            "on_current_main": package_id in metadata, "current_recipe_tree_sha": trees.get(package_id),
            "ever_succeeded": bool(observations), "success_observation_count": len(observations),
            "current_main_status": main_status, "current_pr_status": pr_status,
            "current_main_recipe_succeeded": bool(main),
            "current_pr_head_sha": pr_head(pr) or None,
            "published": bool(published["rpm"] and published["srpm"]),
            "last_success_at": latest.get("completed_at") if latest else None,
            "last_success_run_url": http_link(latest.get("run_url")) if latest else None,
            "observations": [{key: item.get(key) for key in ("id", "head_sha", "workflow_head_sha", "recipe_tree_sha", "run_id", "run_attempt", "event", "head_branch", "completed_at", "evidence_strength", "jobs")} | {"run_url": http_link(item.get("run_url")), "recipe": item.get("recipe")} for item in observations],
            "publication": published,
        })
    snapshot = history.get("snapshot", {})
    return {
        "url": "build-history.json", "source_generated_at": history.get("generated_at"), "cutoff": snapshot.get("cutoff"),
        "current_pr_source_available": bool(github_state and github_state.get("generated_at") and github_state.get("coverage", {}).get("complete") is True and isinstance(github_state.get("pull_requests"), list)),
        "current_pr_source_generated_at": github_state.get("generated_at") if github_state else None,
        "current_pr_source_complete": bool(github_state and github_state.get("coverage", {}).get("complete") is True),
        "coverage_complete": snapshot.get("coverage_complete") is True,
        "lower_bound": snapshot.get("lower_bound") is not False,
        "reasons": list(snapshot.get("reasons", [])),
        "listed_run_count": int(snapshot.get("listed_run_count") or 0),
        "processed_attempt_count": int(snapshot.get("processed_attempt_count") or 0),
        "unresolved_count": int(snapshot.get("unresolved_count") or 0),
        "duplicate_observations_ignored": duplicate_count,
        "publication_coverage": str(published_state.get("coverage", {}).get("status") or "unavailable"),
        "publication_source_generated_at": published_state.get("generated_at"),
        "publication_gaps": list(published_state.get("coverage", {}).get("gaps", [])),
        "publication_files": {key: published_state.get("coverage", {}).get(key) for key in ("verified_files", "rpm_files", "srpm_files")},
        "mapping_conflicts": [{"alias": alias, "package_ids": sorted(ids)} for alias, ids in sorted(resolver.aliases.items()) if len(ids) > 1],
        "managed_mapping_conflicts": resolver.diagnostics,
        "metrics": {
            "cumulative_success_packages": sum(item["ever_succeeded"] for item in packages),
            "current_main_success_packages": sum(item["current_main_recipe_succeeded"] for item in packages),
            "current_pr_success_packages": sum(item["current_pr_status"] == "passed" for item in packages),
            "published_packages": sum(item["published"] for item in packages) if published_state.get("coverage", {}).get("status") == "complete" else None,
            "observed_published_packages": sum(item["published"] for item in packages),
        },
        "definitions": {
            "cumulative": "Unique canonical package IDs with an observed successful build AND installed-smoke step; old versions and PR-only packages remain counted. Hosted step evidence is not physical RPM acceptance.",
            "current_main": "Clean current-checkout whole package Git tree has historically succeeded in an actual main push/dispatch run. This stable historical recipe count is separate from latest known CI status; PR-only success and version-string matches do not qualify.",
            "current_pr": "Successful observation matches the latest OPEN PR exact head; current failures/queued checks take precedence. This is not a main merge or publication.",
            "published": "Unique canonical IDs with any version available in live state-bound primary metadata, matching source/binary EVR and every linked RPM/SRPM byte SHA/size verified. Published EVRs are separate from current-main version. Only complete publication coverage yields a total; partial/unavailable input is not zero. Historical CI never establishes publication.",
            "coverage": "Complete refers only to available listed Actions history through cutoff; deleted or inaccessible runs cannot be reconstructed. Partial snapshots yield a lower bound.",
        },
        "packages": packages,
    }


def main() -> int:
    args = parser().parse_args()
    root = pathlib.Path(args.repo_root).resolve()
    output = pathlib.Path(args.output_dir).resolve()
    packages_dir = root / "packages"
    if not packages_dir.is_dir():
        raise ToolError("packages directory does not exist")
    raw_prs = github_prs(args.github_state)
    github_document = load_json(args.github_state) if args.github_state else None
    builds = build_results(args.build_results)
    publications = publication_evidence(args.build_results)
    published_state, published = load_published_state(args.published_state)
    history = load_history(args.build_history)
    inventory_path = pathlib.Path(args.package_inventory).resolve() if args.package_inventory else root / "catalog" / "package-index.json.gz"
    inventory_document = load_json(inventory_path) if inventory_path.is_file() else {}
    inventory_entries = inventory_document.get("entries", []) if isinstance(inventory_document, Mapping) else []
    if not isinstance(inventory_entries, list):
        raise ToolError("package inventory entries must be an array")
    metadata_by_id: Dict[str, Mapping[str, Any]] = {}
    package_dirs: Dict[str, pathlib.Path] = {}
    resolver = CanonicalPackages()
    for package_dir in sorted(packages_dir.iterdir(), key=lambda path: path.name):
        if not package_dir.is_dir() or package_dir.name.startswith("_") or not (package_dir / "package.yaml").is_file():
            continue
        metadata = load_json(package_dir / "package.yaml")
        package_id = str(metadata.get("package_id") or package_dir.name)
        if package_id != package_dir.name:
            raise ToolError("package metadata ID conflicts with actual directory")
        metadata_by_id[package_id] = metadata
        package_dirs[package_id] = package_dir
        resolver.add(package_id, metadata_aliases(metadata))
    for observation in history.get("observations", []):
        recipe = observation.get("recipe", {})
        resolver.add(str(observation["package_id"]), [recipe.get("rpm_name") or "", *recipe.get("aliases", []), *recipe.get("discovery_keys", [])])
    for package_id in published:
        source_package = next(item for item in published_state["packages"] if item["package_id"] == package_id)
        if package_id not in metadata_by_id or source_package["rpm_name"] != metadata_by_id[package_id].get("rpm", {}).get("name"):
            raise ToolError("published canonical ID/RPM name does not match current metadata")
        resolver.add(package_id, [])
    for pr in raw_prs:
        candidate = package_from_pr(pr, allow_unverified=True)
        paths = pr.get("actual_files", pr.get("files"))
        if candidate and paths and complete_pr_identity(pr, candidate):
            resolver.add(candidate, [])
    # Only an already-unambiguous inventory association can contribute aliases.
    associations = [(entry, resolver.entry(entry)) for entry in inventory_entries if isinstance(entry, Mapping)]
    for entry, package_id in associations:
        if package_id:
            resolver.add(package_id, [str(entry.get("discovery_key") or ""), *entry.get("names", []), *entry.get("aliases", []), *entry.get("component_ids", [])])
    normalized_prs = []
    for pr in raw_prs:
        candidate = package_from_pr(pr, allow_unverified=True)
        package_id = candidate if candidate in resolver.ids else resolver.resolve([candidate])
        if package_id:
            normalized_prs.append(dict(pr, package_id=package_id, canonical_identity_verified=complete_pr_identity(pr, package_id)))
    prs = latest_prs(normalized_prs)
    entries_by_package: Dict[str, Mapping[str, Any]] = {}
    normalized_entries = []
    for entry in inventory_entries:
        if not isinstance(entry, Mapping):
            continue
        package_id = resolver.entry(entry)
        if package_id:
            managed = dict(entry.get("managed_package") or {})
            managed["package_id"] = package_id
            if package_id in metadata_by_id:
                meta = metadata_by_id[package_id]
                managed.update(directory="packages/" + package_id, version=str(meta.get("version", {}).get("current") or "unknown"), summary=meta.get("rpm", {}).get("summary"))
            entry = dict(entry, managed_package=managed)
            entries_by_package[package_id] = entry
        normalized_entries.append(entry)
    update_summary = load_json(args.update_summary) if args.update_summary else {}
    updates = update_entries(update_summary)
    rows: List[Dict[str, Any]] = []
    for package_id, metadata in sorted(metadata_by_id.items()):
        package_dir = package_dirs[package_id]
        rows.append(
            package_row(
                root,
                package_dir,
                metadata,
                entries_by_package.get(package_id),
                prs.get(package_id),
                builds.get(package_id),
                updates.get(package_id),
                publications.get(package_id),
            )
        )
    counts = {state: sum(1 for row in rows if row["status"] == state) for state in sorted(VALID_STATES)}
    catalog = load_json(args.catalog_snapshot) if args.catalog_snapshot else default_catalog(root)
    catalog_summary = catalog.get("summary", {}) if isinstance(catalog, Mapping) else {}
    update_health = {
        "source_available": bool(args.update_summary and isinstance(update_summary, Mapping) and all(key in update_summary for key in ("coverage", "checked_count", "expected_count"))),
        "last_scheduled_at": update_summary.get("scheduled_at"),
        "last_started_at": update_summary.get("started_at") or update_summary.get("scheduled_at"),
        "last_completed_at": update_summary.get("completed_at"),
        "expected": int(update_summary.get("expected_count", 0)),
        "checked": int(update_summary.get("checked_count", 0)),
        "coverage_percent": round(float(update_summary.get("coverage", 0)) * 100, 3),
        "failed_shards": len(update_summary.get("failed_shards", [])),
        "due_rechecks": int(update_summary.get("pending_backfill_count", 0)),
        "consecutive_missed_days": update_summary.get("consecutive_missed_days", 0),
    }
    generated_at = isoformat(parse_now(args.now))
    for row in rows:
        links = published.get(row["package_id"])
        if links:
            row["links"].update(rpm=links["rpm"], srpm=links["srpm"], publication=links["state"])
    full_inventory_rows = [
        inventory_row(
            entry,
            prs.get(str((entry.get("managed_package") or {}).get("package_id") or entry.get("discovery_key") or "")),
            builds.get(str((entry.get("managed_package") or {}).get("package_id") or entry.get("discovery_key") or "")),
            publications.get(str((entry.get("managed_package") or {}).get("package_id") or entry.get("discovery_key") or "")),
        )
        for entry in normalized_entries
        if isinstance(entry, Mapping)
    ]
    inventory_positions: Dict[str, int] = {}
    for row in full_inventory_rows:
        links = published.get(row.get("package_id"))
        if links:
            row.setdefault("links", {}).update(rpm=links["rpm"], srpm=links["srpm"], publication=links["state"])
    for index, row in enumerate(full_inventory_rows):
        inventory_positions[str(row["inventory_id"])] = index
        if row.get("package_id"):
            inventory_positions[str(row["package_id"])] = index
    strong_managed_states = {"published", "build-succeeded", "passed", "failed", "needs-native-riscv", "needs-human", "repair-queued", "codex-repairing", "building", "ci-queued"}
    for managed_row in rows:
        package_id = str(managed_row["package_id"])
        compact_managed = {
            "inventory_id": package_id,
            "package_id": package_id,
            "name": managed_row["name"],
            "version": managed_row["current_version"],
            "status": managed_row["status"],
            "updated_at": managed_row["updated_at"],
            "links": {
                key: managed_row["links"][key]
                for key in ("package", "pr", "ci", "rpm", "srpm", "publication")
                if managed_row["links"].get(key) not in (None, [], "")
            },
        }
        position = inventory_positions.get(package_id)
        if position is None:
            inventory_positions[package_id] = len(full_inventory_rows)
            full_inventory_rows.append(compact_managed)
            continue
        current = full_inventory_rows[position]
        current["package_id"] = package_id
        current["name"] = managed_row["name"]
        current["version"] = managed_row["current_version"]
        if managed_row["status"] in strong_managed_states or current["status"] in {"discovered", "reviewed", "managed", "merged", "merged-pr"}:
            current["status"] = managed_row["status"]
        current["updated_at"] = max(str(current.get("updated_at") or ""), str(managed_row["updated_at"]))
        current.setdefault("links", {}).update(compact_managed["links"])
    present_ids = {row.get("package_id") for row in full_inventory_rows}
    for package_id in sorted(resolver.ids - present_ids):
        pr = prs.get(package_id)
        observation = next((item for item in reversed(history.get("observations", [])) if item["package_id"] == package_id), None)
        recipe = observation.get("recipe", {}) if observation else {}
        full_inventory_rows.append({"inventory_id": "canonical:" + package_id, "package_id": package_id, "name": recipe.get("rpm_name") or package_id, "version": str(recipe.get("version") or "unknown"), "status": pr_state(pr) if pr else "discovered", "links": {key: value for key, value in {"pr": http_link(pr_url(pr)), "ci": http_link(observation.get("run_url")) if observation else None}.items() if value}})
    if not full_inventory_rows:
        full_inventory_rows = [
            {
                "inventory_id": row["package_id"],
                "package_id": row["package_id"],
                "name": row["name"],
                "aliases": [],
                "component_ids": [],
                "version": row["current_version"],
                "status": row["status"],
                "summary": None,
                "decisions": [],
                "updated_at": row["updated_at"],
                "links": {
                    "package": row["links"]["package"],
                    "pr": row["links"]["pr"],
                    "ci": row["links"]["ci"],
                    "rpm": row["links"]["rpm"],
                    "srpm": row["links"]["srpm"],
                    "publication": row["links"]["publication"],
                },
            }
            for row in rows
        ]
    inventory_counts = {state: sum(1 for row in full_inventory_rows if row["status"] == state) for state in sorted(VALID_STATES)}
    inventory_counts = {key: value for key, value in inventory_counts.items() if value}
    source_snapshot = inventory_document.get("source_snapshot") if isinstance(inventory_document, Mapping) else None
    inventory_data = {
        "schema_version": SCHEMA_VERSION,
        "kind": "dashboard-package-inventory",
        "generated_at": generated_at,
        "source": {
            "path": "catalog/package-index.json.gz" if inventory_path == root / "catalog" / "package-index.json.gz" else str(inventory_path),
            "generated_at": inventory_document.get("generated_at") if isinstance(inventory_document, Mapping) else None,
            "main_ref": inventory_document.get("main_ref") if isinstance(inventory_document, Mapping) else None,
            "snapshot_id": source_snapshot.get("snapshot_id") if isinstance(source_snapshot, Mapping) else None,
            "managed_metadata_count": len(rows),
            "build_evidence_count": len(builds),
            "publication_evidence_count": len(publications),
        },
        "status_counts": inventory_counts,
        "entries": full_inventory_rows,
    }
    data = {
        "schema_version": SCHEMA_VERSION,
        "generated_at": generated_at,
        "repository": "yinjiayi/openeuler-riscv-packages",
        "coverage_claim": "full-package-inventory" if inventory_entries else "observed-managed-packages-only",
        "inventory": {
            "url": "inventory.json",
            "entry_count": len(full_inventory_rows),
            "status_counts": inventory_counts,
            "source_generated_at": inventory_data["source"]["generated_at"],
            "main_ref": inventory_data["source"]["main_ref"],
            "snapshot_id": inventory_data["source"]["snapshot_id"],
        },
        "update_health": update_health,
        "packages": rows,
        "build_history": history_view(history, resolver, metadata_by_id, checked_recipe_trees(root, metadata_by_id), prs, builds, published, published_state, github_document if isinstance(github_document, Mapping) else None),
    }
    output.mkdir(parents=True, exist_ok=True)
    copy_assets(root, output)
    atomic_write_json(output / "data.json", data)
    atomic_write_json(output / "build-history.json", data["build_history"])
    if args.build_history:
        # Preserve the validated raw envelope separately from the browser view.
        # Only this schema-valid ledger is suitable for a later collector seed.
        atomic_write_json(output / "build-history-ledger.json", history)
    atomic_write_text(output / "inventory.json", stable_json(inventory_data, pretty=False) + "\n")
    summary = {"generated_at": data["generated_at"], "output_dir": str(output), "package_count": len(rows), "inventory_count": len(full_inventory_rows), "data": str(output / "data.json"), "inventory": str(output / "inventory.json"), "assets": [str(output / name) for name in ("index.html", "app.js", "styles.css")]}
    emit_json(summary, args.output)
    return 0


if __name__ == "__main__":
    run_main(main)

#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Validate local GitHub authentication without exposing its credential."""

from __future__ import annotations

import argparse
import os
import pathlib
import shutil
import subprocess
from typing import Iterable, List, Optional, Set

from _lib import SCHEMA_VERSION, ToolError, emit_json, run_main


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    result.add_argument("--repo-root", default=".")
    result.add_argument("--output")
    result.add_argument("--require-auth", action="store_true")
    result.add_argument("--local-only", action="store_true")
    result.add_argument(
        "--public-path",
        action="append",
        default=["public", "dashboard/site"],
        help="repository-relative generated publication path to inspect; repeatable",
    )
    return result


def contains_secret(path: pathlib.Path, secret: bytes) -> bool:
    if path.is_symlink():
        return secret in os.readlink(str(path)).encode("utf-8", "surrogateescape")
    if not path.is_file():
        return False
    overlap = b""
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            data = overlap + chunk
            if secret in data:
                return True
            overlap = data[-(len(secret) - 1) :] if len(secret) > 1 else b""
    return False


def git_paths(root: pathlib.Path) -> List[pathlib.Path]:
    completed = subprocess.run(
        ["git", "-C", str(root), "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if completed.returncode != 0:
        raise ToolError("repo-root must be a readable Git worktree", 1)
    return [root / os.fsdecode(value) for value in completed.stdout.split(b"\0") if value]


def publication_paths(root: pathlib.Path, values: Iterable[str]) -> List[pathlib.Path]:
    result: List[pathlib.Path] = []
    for value in values:
        candidate = (root / value).resolve()
        try:
            candidate.relative_to(root)
        except ValueError as exc:
            raise ToolError("public-path escapes repo-root: %s" % value, 1) from exc
        if candidate.is_file() or candidate.is_symlink():
            result.append(candidate)
        elif candidate.is_dir():
            result.extend(path for path in candidate.rglob("*") if path.is_file() or path.is_symlink())
    return result


def staged_diff_contains(root: pathlib.Path, secret: bytes) -> bool:
    completed = subprocess.run(
        ["git", "-C", str(root), "diff", "--cached", "--binary", "--no-ext-diff"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if completed.returncode != 0:
        raise ToolError("cannot inspect the staged Git diff", 1)
    return secret in completed.stdout


def authenticated_login(executable: str) -> Optional[str]:
    status = subprocess.run(
        [executable, "auth", "status"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
    )
    if status.returncode != 0:
        return None
    identity = subprocess.run(
        [executable, "api", "user", "--jq", ".login"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
    )
    if identity.returncode != 0:
        return None
    return identity.stdout.strip() or None


def main() -> int:
    args = parser().parse_args()
    root = pathlib.Path(args.repo_root).resolve()
    if args.local_only and os.environ.get("GITHUB_ACTIONS", "").lower() == "true":
        raise ToolError("local-only credential use is forbidden inside GitHub Actions", 1)

    token = os.environ.get("GH_TOKEN")
    if token is not None and len(token.encode("utf-8")) < 20:
        raise ToolError("GH_TOKEN is present but too short to be a GitHub token", 1)

    checked_paths = 0
    if token:
        secret = token.encode("utf-8")
        candidates: Set[pathlib.Path] = set(git_paths(root))
        candidates.update(publication_paths(root, args.public_path))
        exposed: List[str] = []
        for path in sorted(candidates):
            checked_paths += 1
            if contains_secret(path, secret):
                try:
                    exposed.append(str(path.relative_to(root)))
                except ValueError:
                    exposed.append(str(path))
        if staged_diff_contains(root, secret):
            exposed.append("<staged-diff>")
        if exposed:
            raise ToolError(
                "active GH_TOKEN appears in repository/publication content: %s"
                % ", ".join(sorted(set(exposed))),
                1,
            )

    gh = shutil.which("gh")
    login = authenticated_login(gh) if gh else None
    if args.require_auth and not login:
        raise ToolError("GitHub authentication failed; use a local gh login or process-level GH_TOKEN", 1)

    mode = "process-gh-token" if token else ("local-gh-session" if login else "none")
    emit_json(
        {
            "schema_version": SCHEMA_VERSION,
            "kind": "github-credential-preflight",
            "status": "passed" if login or not args.require_auth else "blocked",
            "authentication_mode": mode,
            "login": login,
            "local_only": bool(args.local_only),
            "repository_paths_checked": checked_paths,
            "active_token_absent_from_repository_and_publication_paths": True,
            "token_value_recorded": False,
        },
        args.output,
    )
    return 0


if __name__ == "__main__":
    run_main(main)
